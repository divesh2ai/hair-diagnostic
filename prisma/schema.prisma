  proposedCanonicalValue Json?
  automaticResolutionAllowed Boolean @default(false)
  reviewRequired Boolean @default(true)
  publicationBlocked Boolean @default(true)
  severity       String
  owner          String?
  requiredAction String   @db.Text
  status         String
  resolution     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clinicId, status, severity])
}

model IngestionRun {
  id            String    @id @default(cuid())
  clinicId      String?
  sourceFile    String
  checksum      String
  configVersion String
  status        String
  startedAt     DateTime?
  completedAt   DateTime?
  counts        Json?
  errors        Json?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@unique([clinicId, checksum, configVersion])
}

model KnowledgeSourceFile {
  id                  String   @id @default(cuid())
  fingerprint         String   @unique
  logicalDocumentKey  String
  fileName            String
  mimeType            String
  documentType        String
  domain              String
  sourceType          String
  sourceStatus        String   @default("ACTIVE")
  version             Int
  supersedesSourceId  String?
  extractionMetadata  Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([logicalDocumentKey, version])
  @@index([domain, sourceStatus, sourceType])
}

model KnowledgeIngestionStage {
  id             String   @id @default(cuid())
  sourceFileId   String
  stage          String
  inputHash      String
  outputHash     String?
  status         String
  details        Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  @@unique([sourceFileId, stage, inputHash])
  @@index([sourceFileId, status])
}

model KnowledgeClaim {
  id                    String                     @id @default(cuid())
  claimId               String                     @unique
  chunkId               String
  documentVersionId     String
  domain                String
  subject               String
  subjectType           String
  subjectId             String?
  claimType             String
  statement             String                     @db.Text
  sourceType            String
  sourceId              String
  authorityScore        Int
  evidenceStatus        String
  approvalStatus        KnowledgePublicationStatus @default(DRAFT)
  audience              String
  patientVisible        Boolean                    @default(false)
  medicalReviewStatus   String                     @default("PENDING_REVIEW")
  commercialReviewStatus String                    @default("DRAFT")
  sourceLocation        Json?
  supersessionStatus    String                     @default("ACTIVE")
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  contradictionGroup    String?
  supersededByClaimId   String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([domain, approvalStatus, audience, effectiveFrom])
  @@index([subjectType, subjectId, claimType])
  @@index([contradictionGroup])
}

model ClaimEvidence {
  id             String   @id @default(cuid())
  claimId        String
  sourceFileId   String?
  evidenceType   String
  status         String   @default("UNASSESSED")
  sourceLocation Json
  excerptHash    String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([claimId, status])
  @@index([sourceFileId])
}

model StructuredFactRecord {
  id                String   @id
  sourceFileId      String
  clinicId          String?
  domain            String   @default("HAIR")
  entityType        String
  entityId          String
  field             String
  rawValue          Json?
  normalizedValue   Json?
  provenance        Json
  formula           String?
  formulaResult     Json?
  formulaError      String?
  approvalStatus    String   @default("DRAFT")
  conflictStatus    String   @default("NONE")
  requiresReview    Boolean  @default(true)
  publicationStatus String   @default("DRAFT")
  effectiveFrom     DateTime?
  effectiveUntil    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([entityType, entityId, field, approvalStatus])
  @@index([clinicId, publicationStatus])
}

model KnowledgeReviewAction {
  id            String   @id @default(cuid())
  actorId       String
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model AssistantThread {
  id           String     @id @default(cuid())
  clinicId     String
  patientId    String?
  assessmentId String?
  createdBy    String
  role         SystemRole
  language     String
  title        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([clinicId, createdBy, updatedAt])
}

// Opaque, server-owned context for unauthenticated general-knowledge conversations.
// The browser holds only the random id; trusted entity and source state stays here.
model GeneralAssistantConversation {
  id        String   @id @default(uuid())
  context   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model AssistantMessage {
  id              String   @id @default(cuid())
  threadId        String
  role            String
  content         String   @db.Text
  intent          String?
  action          String?
  language        String
  graphPath       String[]
  authorities     String[]
  supportedClaims Json?
  createdAt       DateTime @default(now())

  @@index([threadId, createdAt])
}

model AssistantToolCall {
  id             String   @id @default(cuid())
  messageId      String
  toolName       String
  input          Json
  redactedOutput Json?
  status         String
  durationMs     Int?
  createdAt      DateTime @default(now())
}

model AssistantCitation {
  id            String   @id @default(cuid())
  messageId     String
  claimIndex    Int
  claimText     String   @db.Text
  sourceType    String
  sourceId      String
  sourceField   String?
  sourceLabel   String
  sourceVersion Int?
  createdAt     DateTime @default(now())

  @@index([messageId, claimIndex])
}

model AssistantSafetyEvent {
  id              String   @id @default(cuid())
  threadId        String
  messageId       String?
  clinicId        String
  patientId       String?
  assessmentId    String?
  flags           String[]
  action          String
  redactedSummary String?  @db.Text
  createdAt       DateTime @default(now())
}

model AssistantFeedback {
  id        String   @id @default(cuid())
  threadId  String
  messageId String?
  clinicId  String
  userId    String
  rating    Int?
  helpful   Boolean?
  category  String?
  comment   String?  @db.Text
  createdAt DateTime @default(now())
}

model AssistantEscalation {
  id               String    @id @default(cuid())
  threadId         String?
  clinicId         String
  patientId        String?
  assessmentId     String?
  messageId        String?
  reason           String
  priority         String
  status           String
  payload          Json
  assignedDoctorId String?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clinicId, status, priority, createdAt])
}

model AdverseEvent {
  id           String   @id @default(cuid())
  threadId     String?
  clinicId     String
  patientId    String?
  assessmentId String?
  productIds   String[]
  symptoms     String   @db.Text
  severity     String
  status       String
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clinicId, status, createdAt])
}
