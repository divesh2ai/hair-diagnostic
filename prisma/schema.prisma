generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

// Single unified role enum for all system actors.
// Controls API-level RBAC â€” applied in middleware, not RLS.
enum SystemRole {
  SUPER_ADMIN
  ORG_ADMIN
  CLINIC_ADMIN
  DOCTOR
  STAFF
  PATIENT
}

enum AssessmentStatus {
  PENDING
  QUEUED
  NORMALIZING
  RUNNING_CLINICAL_ENGINE
  GENERATING_RECOMMENDATIONS
  GENERATING_NARRATIVE
  GENERATING_VIDEO_SCRIPT
  RENDERING_VIDEO
  GENERATING_REPORT
  CLINICAL_READY
  REPORT_GENERATING
  COMPLETED
  FAILED
  PARTIAL_FAILURE
}

enum AssessmentSource {
  QR
  MANUAL
  WEB
  WHATSAPP
}

enum ReviewDecision {
  PENDING
  APPROVED
  EDITS_REQUESTED
  REJECTED
}

// Shadow-mode doctor review pathway persisted on Assessment. This is a
// workflow-routing signal, not a clinical content source of truth.
enum ReviewPathway {
  ROUTINE_REVIEW
  FOCUSED_REVIEW
  EXAMINATION_REQUIRED
  RESOLUTION_REQUIRED
}

enum ArtifactType {
  CLINICAL_REASONING
  SEVERITY_ANALYSIS
  RECOMMENDATIONS
  NARRATIVES
  REPORT
  THERAPY_PLAN
  VISUAL_JOURNEY
  PIPELINE_RUNTIME
  VIDEO_SCRIPT
  AVATAR_VIDEO
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Ordered by addendum Â§6 preference.
enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  IN_APP
}

// Subscription tiers â€” controls clinic-level quotas (assessments/month, doctors,
// storage). Super Admin upgrades/downgrades; usage tracked separately.
enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

// Supported regional languages. Adding a language = extending this enum +
// translation files; business logic stays untouched.
enum SupportedLanguage {
  EN
  HI
  MR
  GU
  PA
  TA
  TE
}

// Operational status for a Clinic â€” distinct from `isActive` (which is a
// legacy soft-on/off). Super Admin transitions the lifecycle here; UI shows
// this as the canonical state.
enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Operational status of a single physical branch. Deliberately NOT ClinicStatus:
// a clinic organisation can be ACTIVE while one of its branches is still
// ONBOARDING or has CLOSED. ONBOARDING has no ClinicStatus equivalent and is
// what the Super Admin network map needs to distinguish.
enum ClinicLocationStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
  CLOSED
}

// Whether a Patient row's identity is settled or still needs a human.
//
// RESOLVED is the ordinary state: the row was created for an unseen number, or
// matched a single existing record. AMBIGUOUS means intake found two or more
// records carrying the same number, refused to pick one, and quarantined this
// visit onto a fresh row — see lib/patient/identity.
//
// This exists so "show me every unresolved identity in clinic X" is a query
// rather than an AuditLog scrape. It is a flag, not a workflow: there is no
// merge engine behind it yet, and reception resolves the row by hand.
enum IdentityResolutionStatus {
  RESOLVED
  AMBIGUOUS
}

// Why the patient is here on THIS visit. Captured at intake, before the
// questionnaire, and never inferred from clinical content or order history.
//
// Kept separate from PatientRelationshipState: "we have seen you before" is a
// fact about the record, "I am here to collect my remaining kits" is a fact
// about today. Collapsing the two is what makes every returning patient look
// like a FOLLOW_UP.
enum VisitType {
  INITIAL
  FOLLOW_UP
  KIT_FULFILMENT
  REASSESSMENT
  NEW_CONCERN
  CONDITION_CHANGED
}

// How intake resolved this visit's patient identity, recorded per assessment.
//
// AMBIGUOUS is a first-class value rather than being folded into RETURNING: a
// quarantined visit is NOT a confirmed returning patient, and a report that
// counts it as one is wrong about the thing that matters most here.
enum PatientRelationshipState {
  NEW
  RETURNING
  AMBIGUOUS
}

// Whether a location can be plotted on the national map, and on what basis.
// UNSET is the honest default: a branch with no verified coordinates is absent
// from the map rather than guessed onto it.
enum LocationGeoStatus {
  UNSET
  PINNED // placed by a human on the map
  GEOCODED // derived from a complete structured address
}

// Lifecycle of a Consultation aggregate. A Consultation always has exactly one
// "current" ConsultationVersion; older versions are retained for audit.
enum ConsultationStatus {
  DRAFT
  AWAITING_DOCTOR_REVIEW
  REVISED
  APPROVED
  ARCHIVED
}

// Outbox event kinds emitted by the consultation orchestrator. Handlers
// subscribe by type; payload shape is defined in the orchestrator package.
enum ConsultationEventType {
  CONSULTATION_CREATED
  CONSULTATION_UPDATED
  CONSULTATION_APPROVED
  DOCTOR_REVIEW_COMPLETED
  REPORT_GENERATED
  PDF_GENERATED
  VIDEO_GENERATION_REQUESTED
  VIDEO_GENERATED
  RAG_INDEX_REQUESTED
  PATIENT_NOTIFICATION_REQUESTED
  PATIENT_NOTIFIED
  FOLLOWUP_CREATED
}

// Approval state captured on each ConsultationVersion. APPROVED versions are
// the ones surfaced to patients; PENDING_REVIEW + REVISION_REQUESTED versions
// are visible only to clinicians.
enum ConsultationApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

// Status of an outbox event row. Dispatch flips PENDING -> PROCESSED on
// successful handler completion, or PENDING -> FAILED on terminal failure.
enum ConsultationEventStatus {
  PENDING
  PROCESSED
  FAILED
}

//////////////////////////////////////////////////////
// ORGANIZATION (top of tenant hierarchy)
//////////////////////////////////////////////////////

// An Organization owns multiple Clinics.
// Supports franchise models (e.g., DrFACT with 10 cities).
model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  contactEmail String?
  contactPhone String?

  country  String  @default("IN")
  timezone String  @default("Asia/Kolkata")
  isActive Boolean @default(true)

  clinics     Clinic[]
  members     OrganizationMember[]
  invitations ClinicInvitation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
}

// Admins scoped to an Organization (ORG_ADMIN, SUPER_ADMIN).
// Doctors are scoped to Clinics â€” not here.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  supabaseUserId String     @unique // auth.users.id from Supabase
  role           SystemRole
  name           String
  email          String     @unique
  // Mobile = WhatsApp number (India-first). Required per addendum Â§4.
  phone          String

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([supabaseUserId])
}

//////////////////////////////////////////////////////
// CLINIC (tenant unit)
//////////////////////////////////////////////////////

model Clinic {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  name     String
  slug     String @unique
  region   String
  language String @default("en")
  timezone String @default("Asia/Kolkata")

  // Legacy free-text address. Superseded by ClinicLocation for anything
  // operational (map, branch routing, QR). Retained because it is the only
  // address on file for existing clinics and is the text a Super Admin
  // structures when setting up the first location. No new consumers.
  address String?
  phone   String?
  email   String?

  // Branding â€” surfaced on the public /q/[clinicSlug] landing page, doctor
  // workspace chrome, PDF + WhatsApp reports. All optional; the consumer
  // falls back to HairOS chrome when unset.
  logoUrl        String?
  tagline        String?
  primaryColor   String? // hex e.g. "#1A73E8" â€” workspace + report accents
  secondaryColor String? // hex â€” secondary accents, header gradient
  accentColor    String? // hex â€” call-to-action / highlight
  footerText     String? // report + PDF footer
  website        String?
  whatsappNumber String? // E.164, e.g. "+919876543210"
  pdfBranding    Json? // { footerText, watermarkUrl, headerStyle, ... }
  reportBranding Json? // { coverStyle, sectionTheme, ... } for in-app reports

  // Patient-facing locales offered by this clinic. Subset of SupportedLanguage.
  // Empty = all locales offered (platform default).
  supportedLanguages SupportedLanguage[] @default([])

  // General clinic settings bag â€” timezone overrides, business hours,
  // assessment duration, auto-archive days, report approval, feature flags.
  // Shape declared in lib/clinic/settings.ts; stored as JSON to avoid
  // churning the schema as toggles evolve.
  settings         Json?
  // WhatsApp business-cloud config â€” businessName, default template ids,
  // welcome/reminder copy, connectionStatus. Shape in lib/clinic/whatsapp.ts.
  whatsappSettings Json?

  status   ClinicStatus @default(ACTIVE)
  isActive Boolean      @default(true)

  subscription Subscription?

  doctors                Doctor[]
  patients               Patient[]
  assessments            Assessment[]
  visits                 ClinicVisit[]
  members                ClinicMember[]
  locations              ClinicLocation[]
  invitations            ClinicInvitation[]
  consultations          Consultation[]
  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]
  appointments           Appointment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([slug])
}

// A physical branch of a Clinic. One Clinic organisation owns one or more
// ClinicLocations â€” "Dr ABC Hair Clinic" in Mumbai with branches in Bandra and
// Andheri is one Clinic and two ClinicLocations.
//
// Scope: this model is the geography and premises of a branch, nothing else.
// Identity, branding, locale, subscription and settings stay on Clinic and are
// deliberately not repeated here. `phone` IS repeated because a branch has its
// own reception line; that is a property of the premises, not the brand.
//
// Every address component is optional. Existing clinics carry only a free-text
// address, and a half-known address must be storable as half-known rather than
// forcing someone to invent a district or a pincode to save the row. What the
// map needs is coordinates, and those are gated separately by `geoStatus`.
model ClinicLocation {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  // Branch label within the clinic, e.g. "Bandra West". Not the clinic name.
  branchName String
  // The branch a patient reaches from the clinic-level QR or link when no
  // specific branch is named. At most one live primary per clinic.
  //
  // Enforced BOTH in the API (demote-then-promote inside a transaction, plus a
  // 409 on demoting the last primary) and in the database:
  //
  //   CREATE UNIQUE INDEX "ClinicLocation_clinicId_primary_key"
  //     ON "ClinicLocation" ("clinicId")
  //     WHERE "isPrimary" = true AND "deletedAt" IS NULL;
  //
  // Prisma cannot express a partial unique index, so it lives in
  // migrations/20260812_clinic_locations and is invisible to `@@unique` here.
  // Do not "fix" that by adding a full @@unique — it would forbid a clinic from
  // having more than one non-primary branch.
  isPrimary  Boolean @default(false)

  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  state        String?
  pincode      String?
  // ISO 3166-1 alpha-2. India-first, but the column exists so a non-IN branch
  // is representable without a schema change.
  country      String  @default("IN")

  // Never populated by inference. A coordinate is written only when a human
  // pins it or a geocoder resolves a complete structured address â€” see
  // `geoStatus`, which records which of those happened.
  latitude   Float?
  longitude  Float?
  geoStatus  LocationGeoStatus @default(UNSET)
  geocodedAt DateTime?

  status ClinicLocationStatus @default(ONBOARDING)

  // Branch reception line. Distinct from Clinic.phone (organisation contact).
  phone String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([clinicId, status])
  // Drill-down queries: India â†’ state â†’ city â†’ clinic.
  @@index([country, state, city])
  // Viewport queries for the national map. A plain btree on the pair is enough
  // for bounding-box scans at the scale we are planning for; PostGIS is not a
  // dependency we need yet.
  @@index([latitude, longitude])
  @@index([geoStatus])
}

// "A named patient is sitting in the clinic right now, filling in the
// assessment." That single operational fact, and nothing else.
//
// ── Why this is not a Patient row, and not an Assessment row ────────────────
// Assessment means SUBMITTED. That invariant is load-bearing: every count,
// queue, engine and report in the platform reads Assessment as completed
// clinical work, and a row created at question one would corrupt all of them.
// A Patient row is equally wrong — identity is resolved and written at
// submission (lib/patient/identity), and creating a person because someone
// scanned a QR code would fill the clinic's records with people who walked out
// halfway through.
//
// So the in-progress state gets its own tiny table, deliberately shaped so
// nothing clinical can ever be hung off it.
//
// ── Deliberately absent ─────────────────────────────────────────────────────
// No phone. The Doctor Dashboard shows a name so the doctor knows who is in
// the waiting room; it has no use for the number, and storing an identifier
// "in case" is how a scratch table becomes a second patient database.
// No status enum, no scheduling, no abandonment workflow, no cleanup worker.
// A visit is open when assessmentId is null; the dashboard simply stops
// showing visits older than a clinic session (see lib/doctor/clinicVisits).
// Long-term purge of abandoned rows is tracked as P2.
//
// No clinicLocationId. The intake session token carries a clinicId and nothing
// else, so a branch would have to be plumbed through the QR link, the landing
// page and the signed token before it could be recorded here. That is a
// separate slice; adding a column now would only guarantee it is null.
model ClinicVisit {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  // The signed intake session (lib/patient/intakeSession) this visit belongs
  // to. Unique because it IS the idempotency key: a patient who edits their
  // name and continues, or a client that retries, must update one visit rather
  // than fill the dashboard with duplicates of the same person.
  intakeSessionId String @unique

  // As typed at intake. A display label for the waiting-room list, never an
  // identity — the patient's real record is resolved at submission.
  displayName String

  // When identity capture succeeded. This is the ONLY thing it is used for:
  //   "Assessment in progress · started 6 min ago"
  // Doctor-review waiting time is measured from Assessment.submittedAt and
  // never from here. See lib/format/waitingTime.
  startedAt DateTime @default(now())

  // Set once, by the submission workflow, in the same transaction that creates
  // the Assessment. Unique so one visit can never be claimed by two
  // submissions. Non-null means the visit is finished: it leaves In Clinic and
  // the assessment appears in the Review Queue.
  assessmentId String?     @unique
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])

  // The dashboard's only query: open visits at this clinic within the session
  // window. Postgres can use all three columns — equality on clinicId, IS NULL
  // on assessmentId, range on startedAt.
  @@index([clinicId, assessmentId, startedAt])
}

// Non-doctor clinic staff (CLINIC_ADMIN, STAFF) bound to a single Clinic and
// to a Supabase auth user. Doctors keep their own model (Doctor) because they
// carry clinical attributes (specialization, public bio, isPrimary). The JWT
// custom_access_token_hook reads this table to inject `clinic_id` for roles
// that aren't doctors. See memory: project_jwt_custom_claims.
model ClinicMember {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  supabaseUserId String // auth.users.id from Supabase
  role           SystemRole // expected: CLINIC_ADMIN | STAFF
  name           String
  email          String
  // Mobile = WhatsApp number. Required per addendum Â§4.
  phone          String

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clinicId, supabaseUserId])
  @@unique([clinicId, email])
  @@unique([clinicId, phone])
  @@index([clinicId])
  @@index([supabaseUserId])
}

// Invitation to join either an Organization (ORG_ADMIN) or a Clinic
// (CLINIC_ADMIN | STAFF | DOCTOR). Exactly one of clinicId/organizationId
// is set per row â€” enforced at the API layer and by the CHECK constraint
// added in the migration. The recipient receives a link containing the
// raw token; the server hashes incoming tokens before lookup so a DB
// leak doesn't expose redeemable invites.
model ClinicInvitation {
  id String @id @default(cuid())

  // Scope â€” exactly one set
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // India-first identity: phone (WhatsApp) is primary, email is secondary.
  // Either must be present; both is preferred. Enforced by CHECK constraint
  // (ClinicInvitation_contact_required) in the accompanying migration.
  email String?
  phone String?
  name  String?

  role SystemRole

  // Notification channel chosen at creation. WHATSAPP is the default per
  // addendum Â§6; sender falls back through SMS â†’ EMAIL â†’ IN_APP.
  channel   NotificationChannel @default(WHATSAPP)
  sentAt    DateTime?
  sendError String?

  // sha256(rawToken). Raw token is returned exactly once at creation; only
  // the hash is stored so a DB leak can't expose redeemable invites.
  tokenHash String @unique

  invitedBySupabaseUserId String?
  invitedByEmail          String?
  invitedByPhone          String?

  status                   InvitationStatus @default(PENDING)
  expiresAt                DateTime
  acceptedAt               DateTime?
  acceptedBySupabaseUserId String?
  revokedAt                DateTime?

  // Slice-1 lifecycle-hardening fields. Resend rotates the tokenHash + bumps
  // these counters via a compare-and-swap so concurrent Resend clicks cannot
  // both deliver messages. `resendCount` also enforces a per-invitation
  // ceiling (P0: 10). `lastResentAt` enforces the 60s cool-down.
  resendCount  Int       @default(0)
  lastResentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([status])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION (per-clinic plan + quotas)
//////////////////////////////////////////////////////

// One row per Clinic. Super Admin manages plan/status; usage counters reset
// at periodEnd. Hard limits live here; the AI Command Center reads them.
model Subscription {
  id String @id @default(cuid())

  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  plan   SubscriptionPlan   @default(TRIAL)
  status SubscriptionStatus @default(ACTIVE)

  // Quota limits â€” null = unlimited.
  monthlyAssessmentLimit Int?
  doctorSeatLimit        Int?
  storageMbLimit         Int?

  // Current period usage (incremented by orchestration / upload pipelines).
  assessmentsThisPeriod Int @default(0)
  storageMbUsed         Int @default(0)

  periodStart DateTime  @default(now())
  periodEnd   DateTime?

  // Free-form notes from Super Admin.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
}

//////////////////////////////////////////////////////
// CLINIC STAFF (Doctor + general staff)
//////////////////////////////////////////////////////

// Doctors are clinic-scoped and linked to Supabase Auth.
model Doctor {
  id String @id @default(cuid())

  supabaseUserId String? @unique

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  name           String
  email          String  @unique
  // Mobile = WhatsApp number. Required per addendum Â§4.
  phone          String?
  specialization String?

  // Public-facing clinician profile, shown on the clinic landing page.
  photoUrl    String?
  credentials String?
  bio         String?
  isPrimary   Boolean @default(false)

  // Doctor avatar (workspace-internal, distinct from public photoUrl) +
  // signature applied to approved reports + preferred UI language.
  avatarUrl         String?
  signatureUrl      String?
  preferredLanguage SupportedLanguage @default(EN)

  // Per-doctor workspace-identity accent (amber, teal, rose, indigo,
  // emerald, slate, gold, plum). Nullable — a null value renders the
  // default theme. Server-persisted so the pick survives across devices,
  // browsers, and Vercel preview URLs (which each have their own origin
  // and therefore their own localStorage).
  badgeTheme String?

  // Clinical credentials shown on reports + PDF. `bio` (legacy) and
  // `biography` coexist â€” `biography` is the editable long-form used in the
  // Clinic Admin profile editor; `bio` remains the short public string.
  qualification      String?
  registrationNumber String?
  biography          String?

  reviewedAssessments Assessment[] @relation("DoctorReviewer")

  patients Patient[]

  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]
  appointments           Appointment[]

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
}

//////////////////////////////////////////////////////
// PATIENT
//////////////////////////////////////////////////////

model Patient {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  supabaseUserId String? @unique

  name            String
  // As typed at intake. Kept verbatim so an unparseable entry (landline,
  // mistyped digit) survives for a receptionist to correct.
  phone           String?
  // Canonical E.164 â€” the identity key. Written only via
  // lib/patient/phone.toE164; null when the input could not be normalised.
  //
  // Deliberately NOT unique on (clinicId, phoneNormalized): submissions
  // created a fresh Patient row per assessment before identity resolution
  // existed, so live data already contains duplicates. Resolution picks the
  // most recent match; historical merging is a separate reviewed job.
  phoneNormalized String?
  email           String?
  age             Int?
  gender          String?

  // Set to AMBIGUOUS when intake found two or more records carrying this
  // number and quarantined the visit onto this fresh row instead of guessing.
  // The row is usable — the patient keeps their completed assessment — but a
  // human still has to say which person it belongs to.
  //
  // Queried as: identityResolutionStatus = 'AMBIGUOUS' AND clinicId = ?
  identityResolutionStatus IdentityResolutionStatus @default(RESOLVED)
  // When the ambiguity was recorded. Null on every RESOLVED row.
  identityFlaggedAt        DateTime?

  identifiers   PatientIdentifier[]
  assessments   Assessment[]
  consultations Consultation[]
  appointments  Appointment[]

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([clinicId, doctorId])
  @@index([phone])
  @@index([clinicId, phoneNormalized])
  // The unresolved-identity worklist: clinic first, then the flag.
  @@index([clinicId, identityResolutionStatus])
}

// External identifier mapping â€” links a patient to QR tokens, WhatsApp IDs, EMR IDs, etc.
// One patient can have multiple external identifiers across different sources.
model PatientIdentifier {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // e.g. "whatsapp" | "qr" | "emr" | "manual"
  source     String
  externalId String

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([patientId])
  @@index([externalId])
}

//////////////////////////////////////////////////////
// APPOINTMENT (scheduled future visit)
//////////////////////////////////////////////////////

// A patient is expected at the clinic at a stated future time.
//
// ── Why this is not ClinicVisit ─────────────────────────────────────────────
// ClinicVisit records "a named patient is in the clinic RIGHT NOW, part-way
// through the assessment" and explicitly refuses scheduling — see its comment.
// That refusal was correct for that table and stays correct: a visit is proven
// by someone physically starting an intake, an appointment is a promise about
// a time that has not happened. Booking a slot must never create a row the
// waiting-room list would render as a person who is present.
//
// The two meet only after the fact, and only in the reading direction: the
// doctor calendar shows appointments as intent and assessments as what
// actually happened on a day. Nothing links an Appointment to the Assessment
// the patient eventually submits — inferring that link from timestamps would
// be a guess, and a wrong guess would quietly rewrite clinical history.
//
// ── Why doctorId is required ────────────────────────────────────────────────
// An appointment is with a clinician, not with a building. A row without a
// doctor cannot be rendered on anyone's day, cannot be checked for conflicts,
// and would surface on every doctor's calendar as unattributed work.
//
// ── scheduledAt is an instant, not a date + slot ────────────────────────────
// Stored UTC, rendered in Clinic.timezone by the reader
// (lib/format/clinicDay). Slot grids are a presentation choice that clinics
// will change; the fact being recorded is a point in time.
//
// ── Deliberately absent ─────────────────────────────────────────────────────
// No recurrence rule, no reminder/notification state, no room or resource, no
// waitlist, no double-booking constraint. Each is a real product decision that
// has not been made. A nullable column added "for later" is a column every
// reader has to handle as null forever.
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // The clinician the patient is booked with. Required — see model comment.
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  // UTC instant. Rendered in the clinic's timezone by the reader.
  scheduledAt     DateTime
  durationMinutes Int      @default(20)

  // Short free text shown on the calendar row, e.g. "3-month follow-up".
  // Not clinical content and never read by any engine.
  reason String?
  notes  String?

  status AppointmentStatus @default(SCHEDULED)

  // Who booked it. Nullable because a future patient-facing or reception
  // booking path would legitimately have no acting doctor, and backfilling
  // this doctor's id onto those rows would be a false attribution.
  createdByDoctorId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  // The calendar's only query: one clinic's appointments inside a month
  // window. Equality on clinicId, range on scheduledAt.
  @@index([clinicId, scheduledAt])
  // "This doctor's day" and "this patient's upcoming visit" respectively.
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
}

//////////////////////////////////////////////////////
// ASSESSMENT (core clinical record)
//////////////////////////////////////////////////////

model Assessment {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  reviewingDoctorId String?
  reviewingDoctor   Doctor? @relation("DoctorReviewer", fields: [reviewingDoctorId], references: [id])

  // Doctor review (token-link approval flow). Captured free-text for tokens
  // shared with doctors who don't yet have a Supabase account; once /doctor
  // auth lands the reviewerName/Email will be backfilled from the session.
  reviewDecision ReviewDecision @default(PENDING)
  reviewerName   String?
  reviewerEmail  String?
  reviewNotes    String?
  reviewedAt     DateTime?

  reviewPathway           ReviewPathway?
  reviewPathwayReasons    String[]        @default([])
  reviewPathwayVersion    String?
  reviewPathwayEvaluatedAt DateTime?
  reviewPathwaySource     Json?

  status AssessmentStatus @default(PENDING)
  source AssessmentSource @default(QR)

  // ── Intake context (D2) ────────────────────────────────────────────────────
  // Both are captured by the pre-assessment intake gate, before question one,
  // and are operational facts about the visit — never clinical input. No
  // engine, scorer or kit rule may read them.
  //
  // Nullable with NO backfill. Every assessment submitted before the intake
  // gate existed genuinely has no recorded intent, and defaulting those rows to
  // INITIAL would invent a fact about hundreds of past visits. Readers treat
  // null as "not captured", which is true.
  visitType           VisitType?
  patientRelationship PatientRelationshipState?

  orchestrationStage String?
  orchestrationMeta  Json?
  executionId        String?
  retryCount         Int     @default(0)
  lastError          String?
  lastCompletedStage String?

  // Phase A execution lease. Written by claimPhaseA on the winning
  // updateMany, refreshed by intra-phase status writes, expired by the
  // reclaim path. A worker whose executionId no longer matches must abort
  // without mutating state (see LeaseLostError). Bounded by phaseAAttempt.
  phaseAExecutionId    String?
  phaseALeaseExpiresAt DateTime?
  phaseAAttempt        Int       @default(0)

  rawResponses Json?

  submittedAt DateTime  @default(now())
  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // The in-clinic visit this submission closed, when the patient came through
  // the intake gate. Absent for every assessment submitted before ClinicVisit
  // existed, and for any client that submits without an intake session.
  clinicVisit ClinicVisit?

  responses              AssessmentResponse[]
  artifacts              AIArtifact[]
  events                 AssessmentEvent[]
  orchestrationLogs      OrchestrationLog[]
  analyticsEvents        AnalyticsEvent[]
  whatsappDeliveries     WhatsappDelivery[]
  auditLogs              AuditLog[]
  consultations          Consultation[]
  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([patientId])
  @@index([reviewingDoctorId])
  @@index([clinicId, status])
  @@index([status, phaseALeaseExpiresAt])
  // "Today's kit-fulfilment visits at this clinic" and the returning-patient
  // split, without scanning the clinic's whole assessment history.
  @@index([clinicId, visitType])
}

model AssessmentResponse {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  questionId String
  answer     Json

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([questionId])
}

