generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

// Single unified role enum for all system actors.
// Controls API-level RBAC â€” applied in middleware, not RLS.
enum SystemRole {
  SUPER_ADMIN
  ORG_ADMIN
  CLINIC_ADMIN
  DOCTOR
  STAFF
  PATIENT
}

enum AssessmentStatus {
  PENDING
  QUEUED
  NORMALIZING
  RUNNING_CLINICAL_ENGINE
  GENERATING_RECOMMENDATIONS
  GENERATING_NARRATIVE
  GENERATING_VIDEO_SCRIPT
  RENDERING_VIDEO
  GENERATING_REPORT
  CLINICAL_READY
  REPORT_GENERATING
  COMPLETED
  FAILED
  PARTIAL_FAILURE
}

enum AssessmentSource {
  QR
  MANUAL
  WEB
  WHATSAPP
}

enum ReviewDecision {
  PENDING
  APPROVED
  EDITS_REQUESTED
  REJECTED
}

// Shadow-mode doctor review pathway persisted on Assessment. This is a
// workflow-routing signal, not a clinical content source of truth.
enum ReviewPathway {
  ROUTINE_REVIEW
  FOCUSED_REVIEW
  EXAMINATION_REQUIRED
  RESOLUTION_REQUIRED
}

enum ArtifactType {
  CLINICAL_REASONING
  SEVERITY_ANALYSIS
  RECOMMENDATIONS
  NARRATIVES
  REPORT
  THERAPY_PLAN
  VISUAL_JOURNEY
  PIPELINE_RUNTIME
  VIDEO_SCRIPT
  AVATAR_VIDEO
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Ordered by addendum Â§6 preference.
enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  IN_APP
}

// Subscription tiers â€” controls clinic-level quotas (assessments/month, doctors,
// storage). Super Admin upgrades/downgrades; usage tracked separately.
enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

// Supported regional languages. Adding a language = extending this enum +
// translation files; business logic stays untouched.
enum SupportedLanguage {
  EN
  HI
  MR
  GU
  PA
  TA
  TE
}

// Operational status for a Clinic â€” distinct from `isActive` (which is a
// legacy soft-on/off). Super Admin transitions the lifecycle here; UI shows
// this as the canonical state.
enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Lifecycle of a Consultation aggregate. A Consultation always has exactly one
// "current" ConsultationVersion; older versions are retained for audit.
enum ConsultationStatus {
  DRAFT
  AWAITING_DOCTOR_REVIEW
  REVISED
  APPROVED
  ARCHIVED
}

// Outbox event kinds emitted by the consultation orchestrator. Handlers
// subscribe by type; payload shape is defined in the orchestrator package.
enum ConsultationEventType {
  CONSULTATION_CREATED
  CONSULTATION_UPDATED
  CONSULTATION_APPROVED
  DOCTOR_REVIEW_COMPLETED
  REPORT_GENERATED
  PDF_GENERATED
  VIDEO_GENERATION_REQUESTED
  VIDEO_GENERATED
  RAG_INDEX_REQUESTED
  PATIENT_NOTIFICATION_REQUESTED
  PATIENT_NOTIFIED
  FOLLOWUP_CREATED
}

// Approval state captured on each ConsultationVersion. APPROVED versions are
// the ones surfaced to patients; PENDING_REVIEW + REVISION_REQUESTED versions
// are visible only to clinicians.
enum ConsultationApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

// Status of an outbox event row. Dispatch flips PENDING -> PROCESSED on
// successful handler completion, or PENDING -> FAILED on terminal failure.
enum ConsultationEventStatus {
  PENDING
  PROCESSED
  FAILED
}

//////////////////////////////////////////////////////
// ORGANIZATION (top of tenant hierarchy)
//////////////////////////////////////////////////////

// An Organization owns multiple Clinics.
// Supports franchise models (e.g., DrFACT with 10 cities).
model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  contactEmail String?
  contactPhone String?

  country  String  @default("IN")
  timezone String  @default("Asia/Kolkata")
  isActive Boolean @default(true)

  clinics     Clinic[]
  members     OrganizationMember[]
  invitations ClinicInvitation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
}

// Admins scoped to an Organization (ORG_ADMIN, SUPER_ADMIN).
// Doctors are scoped to Clinics â€” not here.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  supabaseUserId String     @unique // auth.users.id from Supabase
  role           SystemRole
  name           String
  email          String     @unique
  // Mobile = WhatsApp number (India-first). Required per addendum Â§4.
  phone          String

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([supabaseUserId])
}

//////////////////////////////////////////////////////
// CLINIC (tenant unit)
//////////////////////////////////////////////////////

model Clinic {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  name     String
  slug     String @unique
  region   String
  language String @default("en")
  timezone String @default("Asia/Kolkata")

  address String?
  phone   String?
  email   String?

  // Branding â€” surfaced on the public /q/[clinicSlug] landing page, doctor
  // workspace chrome, PDF + WhatsApp reports. All optional; the consumer
  // falls back to HairOS chrome when unset.
  logoUrl        String?
  tagline        String?
  primaryColor   String? // hex e.g. "#1A73E8" â€” workspace + report accents
  secondaryColor String? // hex â€” secondary accents, header gradient
  accentColor    String? // hex â€” call-to-action / highlight
  footerText     String? // report + PDF footer
  website        String?
  whatsappNumber String? // E.164, e.g. "+919876543210"
  pdfBranding    Json? // { footerText, watermarkUrl, headerStyle, ... }
  reportBranding Json? // { coverStyle, sectionTheme, ... } for in-app reports

  // Patient-facing locales offered by this clinic. Subset of SupportedLanguage.
  // Empty = all locales offered (platform default).
  supportedLanguages SupportedLanguage[] @default([])

  // General clinic settings bag â€” timezone overrides, business hours,
  // assessment duration, auto-archive days, report approval, feature flags.
  // Shape declared in lib/clinic/settings.ts; stored as JSON to avoid
  // churning the schema as toggles evolve.
  settings         Json?
  // WhatsApp business-cloud config â€” businessName, default template ids,
  // welcome/reminder copy, connectionStatus. Shape in lib/clinic/whatsapp.ts.
  whatsappSettings Json?

  status   ClinicStatus @default(ACTIVE)
  isActive Boolean      @default(true)

  subscription Subscription?

  doctors                Doctor[]
  patients               Patient[]
  assessments            Assessment[]
  members                ClinicMember[]
  invitations            ClinicInvitation[]
  consultations          Consultation[]
  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([slug])
}

// Non-doctor clinic staff (CLINIC_ADMIN, STAFF) bound to a single Clinic and
// to a Supabase auth user. Doctors keep their own model (Doctor) because they
// carry clinical attributes (specialization, public bio, isPrimary). The JWT
// custom_access_token_hook reads this table to inject `clinic_id` for roles
// that aren't doctors. See memory: project_jwt_custom_claims.
model ClinicMember {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  supabaseUserId String // auth.users.id from Supabase
  role           SystemRole // expected: CLINIC_ADMIN | STAFF
  name           String
  email          String
  // Mobile = WhatsApp number. Required per addendum Â§4.
  phone          String

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clinicId, supabaseUserId])
  @@unique([clinicId, email])
  @@unique([clinicId, phone])
  @@index([clinicId])
  @@index([supabaseUserId])
}

// Invitation to join either an Organization (ORG_ADMIN) or a Clinic
// (CLINIC_ADMIN | STAFF | DOCTOR). Exactly one of clinicId/organizationId
// is set per row â€” enforced at the API layer and by the CHECK constraint
// added in the migration. The recipient receives a link containing the
// raw token; the server hashes incoming tokens before lookup so a DB
// leak doesn't expose redeemable invites.
model ClinicInvitation {
  id String @id @default(cuid())

  // Scope â€” exactly one set
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // India-first identity: phone (WhatsApp) is primary, email is secondary.
  // Either must be present; both is preferred. Enforced by CHECK constraint
  // (ClinicInvitation_contact_required) in the accompanying migration.
  email String?
  phone String?
  name  String?

  role SystemRole

  // Notification channel chosen at creation. WHATSAPP is the default per
  // addendum Â§6; sender falls back through SMS â†’ EMAIL â†’ IN_APP.
  channel   NotificationChannel @default(WHATSAPP)
  sentAt    DateTime?
  sendError String?

  // sha256(rawToken). Raw token is returned exactly once at creation; only
  // the hash is stored so a DB leak can't expose redeemable invites.
  tokenHash String @unique

  invitedBySupabaseUserId String?
  invitedByEmail          String?
  invitedByPhone          String?

  status                   InvitationStatus @default(PENDING)
  expiresAt                DateTime
  acceptedAt               DateTime?
  acceptedBySupabaseUserId String?
  revokedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([status])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION (per-clinic plan + quotas)
//////////////////////////////////////////////////////

// One row per Clinic. Super Admin manages plan/status; usage counters reset
// at periodEnd. Hard limits live here; the AI Command Center reads them.
model Subscription {
  id String @id @default(cuid())

  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  plan   SubscriptionPlan   @default(TRIAL)
  status SubscriptionStatus @default(ACTIVE)

  // Quota limits â€” null = unlimited.
  monthlyAssessmentLimit Int?
  doctorSeatLimit        Int?
  storageMbLimit         Int?

  // Current period usage (incremented by orchestration / upload pipelines).
  assessmentsThisPeriod Int @default(0)
  storageMbUsed         Int @default(0)

  periodStart DateTime  @default(now())
  periodEnd   DateTime?

  // Free-form notes from Super Admin.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
}

//////////////////////////////////////////////////////
// CLINIC STAFF (Doctor + general staff)
//////////////////////////////////////////////////////

// Doctors are clinic-scoped and linked to Supabase Auth.
model Doctor {
  id String @id @default(cuid())

  supabaseUserId String? @unique

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  name           String
  email          String  @unique
  // Mobile = WhatsApp number. Required per addendum Â§4.
  phone          String?
  specialization String?

  // Public-facing clinician profile, shown on the clinic landing page.
  photoUrl    String?
  credentials String?
  bio         String?
  isPrimary   Boolean @default(false)

  // Doctor avatar (workspace-internal, distinct from public photoUrl) +
  // signature applied to approved reports + preferred UI language.
  avatarUrl         String?
  signatureUrl      String?
  preferredLanguage SupportedLanguage @default(EN)

  // Clinical credentials shown on reports + PDF. `bio` (legacy) and
  // `biography` coexist â€” `biography` is the editable long-form used in the
  // Clinic Admin profile editor; `bio` remains the short public string.
  qualification      String?
  registrationNumber String?
  biography          String?

  reviewedAssessments Assessment[] @relation("DoctorReviewer")

  patients Patient[]

  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
}

//////////////////////////////////////////////////////
// PATIENT
//////////////////////////////////////////////////////

model Patient {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  supabaseUserId String? @unique

  name   String
  phone  String?
  email  String?
  age    Int?
  gender String?

  identifiers   PatientIdentifier[]
  assessments   Assessment[]
  consultations Consultation[]

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([clinicId, doctorId])
  @@index([phone])
}

// External identifier mapping â€” links a patient to QR tokens, WhatsApp IDs, EMR IDs, etc.
// One patient can have multiple external identifiers across different sources.
model PatientIdentifier {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // e.g. "whatsapp" | "qr" | "emr" | "manual"
  source     String
  externalId String

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([patientId])
  @@index([externalId])
}

//////////////////////////////////////////////////////
// ASSESSMENT (core clinical record)
//////////////////////////////////////////////////////

model Assessment {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  reviewingDoctorId String?
  reviewingDoctor   Doctor? @relation("DoctorReviewer", fields: [reviewingDoctorId], references: [id])

  // Doctor review (token-link approval flow). Captured free-text for tokens
  // shared with doctors who don't yet have a Supabase account; once /doctor
  // auth lands the reviewerName/Email will be backfilled from the session.
  reviewDecision ReviewDecision @default(PENDING)
  reviewerName   String?
  reviewerEmail  String?
  reviewNotes    String?
  reviewedAt     DateTime?

  reviewPathway           ReviewPathway?
  reviewPathwayReasons    String[]        @default([])
  reviewPathwayVersion    String?
  reviewPathwayEvaluatedAt DateTime?
  reviewPathwaySource     Json?

  status AssessmentStatus @default(PENDING)
  source AssessmentSource @default(QR)

  orchestrationStage String?
  orchestrationMeta  Json?
  executionId        String?
  retryCount         Int     @default(0)
  lastError          String?
  lastCompletedStage String?

  // Phase A execution lease. Written by claimPhaseA on the winning
  // updateMany, refreshed by intra-phase status writes, expired by the
  // reclaim path. A worker whose executionId no longer matches must abort
  // without mutating state (see LeaseLostError). Bounded by phaseAAttempt.
  phaseAExecutionId    String?
  phaseALeaseExpiresAt DateTime?
  phaseAAttempt        Int       @default(0)

  rawResponses Json?

  submittedAt DateTime  @default(now())
  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  responses              AssessmentResponse[]
  artifacts              AIArtifact[]
  events                 AssessmentEvent[]
  orchestrationLogs      OrchestrationLog[]
  analyticsEvents        AnalyticsEvent[]
  whatsappDeliveries     WhatsappDelivery[]
  auditLogs              AuditLog[]
  consultations          Consultation[]
  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([patientId])
  @@index([reviewingDoctorId])
  @@index([clinicId, status])
  @@index([status, phaseALeaseExpiresAt])
}

model AssessmentResponse {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  questionId String
  answer     Json

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([questionId])
}

//////////////////////////////////////////////////////
// AI ARTIFACT SYSTEM
//////////////////////////////////////////////////////

// Every AI output is stored as a typed artifact.
// RBAC controls which roles can read which artifact types.
// Patients: no access. Doctors/Admins: full access.
model AIArtifact {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  type ArtifactType

  engineVersion String?
  schemaVersion String?

  content Json

  generationMs Int?

  createdAt DateTime @default(now())

  @@unique([assessmentId, type])
  @@index([assessmentId])
  @@index([assessmentId, type])
}

//////////////////////////////////////////////////////
// ORCHESTRATION / PIPELINE LOGGING
//////////////////////////////////////////////////////

model OrchestrationLog {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  stage       String
  status      String
  durationMs  Int?
  confidence  Float?
  uncertainty Json?
  metadata    Json?
  error       String?

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([assessmentId, stage])
}

// Full event sourcing log â€” every lifecycle transition is recorded here.
// Used for orchestration debugging, audit trails, and the viewer timeline.
model AssessmentEvent {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  type       String // SUBMITTED | QUEUED | ORCHESTRATION_STARTED | etc.
  stage      String?
  message    String?
  metadata   Json?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([type])
  @@index([assessmentId, createdAt])
}

//////////////////////////////////////////////////////
// ANALYTICS
//////////////////////////////////////////////////////

model AnalyticsEvent {
  id String @id @default(cuid())

  // Both optional â€” some events are platform-level, not clinic-level
  clinicId     String?
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])

  eventType String
  payload   Json?

  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([eventType])
  @@index([clinicId, eventType])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// WHATSAPP DELIVERY
//////////////////////////////////////////////////////

model WhatsappDelivery {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  patientPhone String
  templateId   String?
  status       DeliveryStatus @default(PENDING)
  messageId    String?
  attempts     Int            @default(0)
  lastError    String?
  deliveredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([status])
}

//////////////////////////////////////////////////////
// AUDIT LOGGING
//////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(cuid())

  // Who performed the action
  actorId   String?
  actorRole SystemRole?
  actorType String? // "doctor" | "admin" | "system" | "patient"

  // What was acted upon
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  entityType   String
  entityId     String

  action   String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([assessmentId])
}

//////////////////////////////////////////////////////
// PLATFORM SETTINGS (Super Admin owned, singleton)
//////////////////////////////////////////////////////

// Singleton row â€” enforced by `singletonKey = 'singleton'` unique. Holds
// platform-wide defaults the Super Admin tunes from /admin/settings.
model PlatformSettings {
  id           String @id @default(cuid())
  singletonKey String @unique @default("singleton")

  platformName            String            @default("HairOS")
  defaultTheme            String            @default("system") // light | dark | system
  defaultLanguage         SupportedLanguage @default(EN)
  defaultWhatsappTemplate String?

  // AI defaults (read-only in this phase â€” surfaced for visibility).
  aiModelDefault String?
  aiNotes        String?

  versionInfo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// LEGACY CHAT / WHATSAPP SESSION ENGINE
// Keep intact â€” do not touch without explicit migration plan
//////////////////////////////////////////////////////

model User {
  id    String  @id @default(cuid())
  name  String?
  phone String?

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model Session {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  state Json

  messages         Message[]
  diagnosis        Diagnosis?
  whatsappSessions WhatsappSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsappSession {
  id String @id @default(cuid())

  waId String @unique

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  sender   String
  text     String?
  metadata Json?

  createdAt DateTime @default(now())
}

model Diagnosis {
  id String @id @default(cuid())

  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id])

  condition  String
  confidence Float

  rootCauses      Json
  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recommendation {
  id String @id @default(cuid())

  diagnosisId String
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id])

  title     String
  productId String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CONSULTATION AGGREGATE (Sprint 2 â€” orchestrator output)
//////////////////////////////////////////////////////

// The Consultation aggregate root. One per Assessment per clinical workflow.
// Holds a pointer to the latest ConsultationVersion; older versions remain
// immutable for audit + diffing. Tenant-scoped via clinicId.
model Consultation {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  status ConsultationStatus @default(DRAFT)

  // Pointer to the latest version. Always set after createConsultation.
  currentVersionId String?              @unique
  currentVersion   ConsultationVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  versions               ConsultationVersion[]    @relation("ConsultationVersions")
  events                 ConsultationEvent[]
  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId])
  @@index([clinicId])
  @@index([patientId])
  @@index([clinicId, status])
}

// Immutable snapshot of a consultation's content. New versions are appended
// on doctor edits; the canonical Consultation JSON lives in `content`.
model ConsultationVersion {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation("ConsultationVersions", fields: [consultationId], references: [id])

  // Monotonic per consultation â€” 1, 2, 3 â€¦
  contentVersion Int
  schemaVersion  String @default("v1")

  // Snapshot of @shared/types/consultation.Consultation.
  content Json

  // Per-engine version stamps captured at composition time. Used for cache
  // invalidation and replay.
  engineVersions Json

  // Deterministic SHA-256 of normalized `content`. Used for idempotency:
  // re-running the pipeline with identical inputs skips creating a duplicate
  // version.
  contentHash String

  // AI provenance â€” captured for regression testing + audit. Null on
  // versions produced purely by deterministic engines (no LLM in the loop).
  llmModel             String?
  promptVersion        String?
  knowledgeBaseVersion String?

  // Clinical approval lifecycle. Patient-facing surfaces should only show
  // versions where approvalStatus = APPROVED.
  approvalStatus ConsultationApprovalStatus @default(PENDING_REVIEW)
  approvedBy     String?
  approvedAt     DateTime?

  // Doctor-supplied notes captured at approval time (e.g., reason for edit).
  // Kept on the version row so audits don't need to chase the audit log.
  approvalNotes String?

  createdBy String
  createdAt DateTime @default(now())

  // Back-reference used only when this row is the current pointer.
  currentOf Consultation? @relation("CurrentVersion")

  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]

  @@unique([consultationId, contentVersion])
  @@index([consultationId])
  @@index([contentHash])
}

// Durable outbox of domain events emitted by the orchestrator. Written in the
// same transaction as the version that produced them; dispatched out-of-band
// by an in-process handler today, ready for a real queue later.
model ConsultationEvent {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  type    ConsultationEventType
  status  ConsultationEventStatus @default(PENDING)
  payload Json

  // The version that caused the event, when applicable. Null for events that
  // are version-independent (e.g., PATIENT_NOTIFICATION_REQUESTED).
  consultationVersionId String?

  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([consultationId])
  @@index([status, createdAt])
  @@index([type, status])
}

//////////////////////////////////////////////////////
// DOCTOR VALIDATION LOOP â€” order intent + feedback
//////////////////////////////////////////////////////

// Canonical, minimal durable record of the doctor's approval-time intent to
// operationalize the approved kit lineup. This is NOT billing, inventory,
// payments, or fulfilment â€” just the least amount of state needed for ops to
// act on the doctor's authorization.
//
// Idempotency is guaranteed by @@unique([consultationId, consultationVersionId]):
// repeated "Approve & create kit order" clicks against the same approved
// version return the same intent row.
model KitOrderIntent {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  consultationVersionId String
  consultationVersion   ConsultationVersion @relation(fields: [consultationVersionId], references: [id])

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  // Kit lineup captured at approval time â€” audit-stable snapshot. `kitIds`
  // is the doctor's final order; `quantities` is a { kitId: number } map or
  // null when quantities aren't defined yet.
  kitIds     String[]
  quantities Json?

  // Doctor approval IS the clinical authorization; ops picks up from here.
  status KitOrderStatus @default(READY_FOR_FULFILMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consultationId, consultationVersionId])
  @@index([clinicId, createdAt])
  @@index([doctorId])
  @@index([assessmentId])
}

enum KitOrderStatus {
  READY_FOR_FULFILMENT
  CANCELLED
}

// Structured doctor feedback on a specific consultation version. Never mutates
// recommendations automatically â€” this is the pilot's learning-loop capture.
// clinicalRationale is required at write time for SAFETY_CONCERN / INCORRECT
// (validated in the endpoint), optional otherwise.
model RecommendationFeedback {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  // The version the doctor was reviewing when the feedback was recorded.
  consultationVersionId String
  consultationVersion   ConsultationVersion @relation(fields: [consultationVersionId], references: [id])

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  verdict           FeedbackVerdict
  issueType         FeedbackIssueType
  severity          FeedbackSeverity
  expectedKitOrder  String[]
  affectedKitIds    String[]
  clinicalRationale String?           @db.Text

  createdAt DateTime @default(now())

  @@index([consultationId])
  @@index([clinicId, createdAt])
  @@index([doctorId])
}

enum FeedbackVerdict {
  CORRECT
  PARTLY_CORRECT
  INCORRECT
  SAFETY_CONCERN
}

// Recommendation feedback categories are strictly clinical. "Needs revision"
// is a consultation-workflow action captured via the approve endpoint, NOT a
// feedback category, so it does not appear here.
enum FeedbackIssueType {
  WRONG_KIT_INCLUDED
  WRONG_KIT_EXCLUDED
  WRONG_ORDER
  MISSING_KIT
  SAFETY_ISSUE
  CONDITION_INTERPRETATION
  NARRATIVE_ONLY
  OTHER
}

enum FeedbackSeverity {
  LOW
  MEDIUM
  HIGH
}

