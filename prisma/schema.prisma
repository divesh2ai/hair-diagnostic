generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

// Single unified role enum for all system actors.
// Controls API-level RBAC â€” applied in middleware, not RLS.
enum SystemRole {
  SUPER_ADMIN
  ORG_ADMIN
  CLINIC_ADMIN
  DOCTOR
  STAFF
  PATIENT
}

enum AssessmentStatus {
  PENDING
  QUEUED
  NORMALIZING
  RUNNING_CLINICAL_ENGINE
  GENERATING_RECOMMENDATIONS
  GENERATING_NARRATIVE
  GENERATING_VIDEO_SCRIPT
  RENDERING_VIDEO
  GENERATING_REPORT
  CLINICAL_READY
  REPORT_GENERATING
  COMPLETED
  FAILED
  PARTIAL_FAILURE
}

enum AssessmentSource {
  QR
  MANUAL
  WEB
  WHATSAPP
}

enum ReviewDecision {
  PENDING
  APPROVED
  EDITS_REQUESTED
  REJECTED
}

// Shadow-mode doctor review pathway persisted on Assessment. This is a
// workflow-routing signal, not a clinical content source of truth.
enum ReviewPathway {
  ROUTINE_REVIEW
  FOCUSED_REVIEW
  EXAMINATION_REQUIRED
  RESOLUTION_REQUIRED
}

enum ArtifactType {
  CLINICAL_REASONING
  SEVERITY_ANALYSIS
  RECOMMENDATIONS
  NARRATIVES
  REPORT
  THERAPY_PLAN
  VISUAL_JOURNEY
  PIPELINE_RUNTIME
  VIDEO_SCRIPT
  AVATAR_VIDEO
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  /// Added 20260908_whatsapp_report_delivery. Credentials for the resolved
  /// sender (central or clinic-specific) are missing/invalid — distinct from
  /// FAILED so the doctor UI never offers "Retry WhatsApp" for a deployment
  /// issue only an operator can fix.
  CONFIGURATION_ERROR
  /// Added 20260908_whatsapp_report_delivery. Written instead of calling the
  /// provider when the patient has not given WhatsApp consent.
  BLOCKED_NO_CONSENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Ordered by addendum Â§6 preference.
enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  IN_APP
}

// Subscription tiers â€” controls clinic-level quotas (assessments/month, doctors,
// storage). Super Admin upgrades/downgrades; usage tracked separately.
enum SubscriptionPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

// Supported regional languages. Adding a language = extending this enum +
// translation files; business logic stays untouched.
enum SupportedLanguage {
  EN
  HI
  MR
  GU
  PA
  TA
  TE
}

// Operational status for a Clinic â€” distinct from `isActive` (which is a
// legacy soft-on/off). Super Admin transitions the lifecycle here; UI shows
// this as the canonical state.
enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Operational status of a single physical branch. Deliberately NOT ClinicStatus:
// a clinic organisation can be ACTIVE while one of its branches is still
// ONBOARDING or has CLOSED. ONBOARDING has no ClinicStatus equivalent and is
// what the Super Admin network map needs to distinguish.
enum ClinicLocationStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
  CLOSED
}

// Whether a Patient row's identity is settled or still needs a human.
//
// RESOLVED is the ordinary state: the row was created for an unseen number, or
// matched a single existing record. AMBIGUOUS means intake found two or more
// records carrying the same number, refused to pick one, and quarantined this
// visit onto a fresh row — see lib/patient/identity.
//
// This exists so "show me every unresolved identity in clinic X" is a query
// rather than an AuditLog scrape. It is a flag, not a workflow: there is no
// merge engine behind it yet, and reception resolves the row by hand.
enum IdentityResolutionStatus {
  RESOLVED
  AMBIGUOUS
}

// Why the patient is here on THIS visit. Captured at intake, before the
// questionnaire, and never inferred from clinical content or order history.
//
// Kept separate from PatientRelationshipState: "we have seen you before" is a
// fact about the record, "I am here to collect my remaining kits" is a fact
// about today. Collapsing the two is what makes every returning patient look
// like a FOLLOW_UP.
enum VisitType {
  INITIAL
  FOLLOW_UP
  KIT_FULFILMENT
  REASSESSMENT
  NEW_CONCERN
  CONDITION_CHANGED
}

// How intake resolved this visit's patient identity, recorded per assessment.
//
// AMBIGUOUS is a first-class value rather than being folded into RETURNING: a
// quarantined visit is NOT a confirmed returning patient, and a report that
// counts it as one is wrong about the thing that matters most here.
enum PatientRelationshipState {
  NEW
  RETURNING
  AMBIGUOUS
}

// Whether a location can be plotted on the national map, and on what basis.
// UNSET is the honest default: a branch with no verified coordinates is absent
// from the map rather than guessed onto it.
enum LocationGeoStatus {
  UNSET
  PINNED // placed by a human on the map
  GEOCODED // derived from a complete structured address
}

// Lifecycle of a Consultation aggregate. A Consultation always has exactly one
// "current" ConsultationVersion; older versions are retained for audit.
enum ConsultationStatus {
  DRAFT
  AWAITING_DOCTOR_REVIEW
  REVISED
  APPROVED
  ARCHIVED
}

// Outbox event kinds emitted by the consultation orchestrator. Handlers
// subscribe by type; payload shape is defined in the orchestrator package.
enum ConsultationEventType {
  CONSULTATION_CREATED
  CONSULTATION_UPDATED
  CONSULTATION_APPROVED
  DOCTOR_REVIEW_COMPLETED
  REPORT_GENERATED
  PDF_GENERATED
  VIDEO_GENERATION_REQUESTED
  VIDEO_GENERATED
  RAG_INDEX_REQUESTED
  PATIENT_NOTIFICATION_REQUESTED
  PATIENT_NOTIFIED
  FOLLOWUP_CREATED
}

// Approval state captured on each ConsultationVersion. APPROVED versions are
// the ones surfaced to patients; PENDING_REVIEW + REVISION_REQUESTED versions
// are visible only to clinicians.
// How far a Doctor row is from being a usable login. Distinct from isActive
// (is this clinician practising?) and from supabaseUserId (is an auth account
// linked?), because the fact that decides whether an invitation may be sent is
// neither of those - it is whether a human has confirmed a PERSONAL contact.
//
//   CONTACT_REQUIRED  Profile and clinic relationship exist. No confirmed
//                     personal email or mobile, so no invitation can be sent
//                     and no login is possible. The honest default.
//   READY_TO_INVITE   A confirmed personal contact is on file. Nothing sent.
//   INVITED           An invitation has been sent and not yet accepted.
//   ACTIVE            An auth account is linked; the doctor can sign in.
enum DoctorProvisioningStatus {
  CONTACT_REQUIRED
  READY_TO_INVITE
  INVITED
  ACTIVE
}

enum ConsultationApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

// Status of an outbox event row. Dispatch flips PENDING -> PROCESSED on
// successful handler completion, or PENDING -> FAILED on terminal failure.
enum ConsultationEventStatus {
  PENDING
  PROCESSED
  FAILED
}

//////////////////////////////////////////////////////
// ORGANIZATION (top of tenant hierarchy)
//////////////////////////////////////////////////////

// An Organization owns multiple Clinics.
// Supports franchise models (e.g., DrFACT with 10 cities).
model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  contactEmail String?
  contactPhone String?

  country  String  @default("IN")
  timezone String  @default("Asia/Kolkata")
  isActive Boolean @default(true)

  clinics     Clinic[]
  members     OrganizationMember[]
  invitations ClinicInvitation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
}

// Admins scoped to an Organization (ORG_ADMIN, SUPER_ADMIN).
// Doctors are scoped to Clinics â€” not here.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  supabaseUserId String     @unique // auth.users.id from Supabase
  role           SystemRole
  name           String
  email          String     @unique
  // Mobile = WhatsApp number (India-first). Required per addendum Â§4.
  phone          String

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([supabaseUserId])
}

//////////////////////////////////////////////////////
// CLINIC (tenant unit)
//////////////////////////////////////////////////////

model Clinic {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  name     String
  slug     String @unique
  region   String
  language String @default("en")
  timezone String @default("Asia/Kolkata")

  // Legacy free-text address. Superseded by ClinicLocation for anything
  // operational (map, branch routing, QR). Retained because it is the only
  // address on file for existing clinics and is the text a Super Admin
  // structures when setting up the first location. No new consumers.
  address String?
  phone   String?
  email   String?

  // Branding â€” surfaced on the public /q/[clinicSlug] landing page, doctor
  // workspace chrome, PDF + WhatsApp reports. All optional; the consumer
  // falls back to HairOS chrome when unset.
  logoUrl        String?
  tagline        String?
  primaryColor   String? // hex e.g. "#1A73E8" â€” workspace + report accents
  secondaryColor String? // hex â€” secondary accents, header gradient
  accentColor    String? // hex â€” call-to-action / highlight
  footerText     String? // report + PDF footer
  website        String?
  whatsappNumber String? // E.164, e.g. "+919876543210"
  pdfBranding    Json? // { footerText, watermarkUrl, headerStyle, ... }
  reportBranding Json? // { coverStyle, sectionTheme, ... } for in-app reports

  // Patient-facing locales offered by this clinic. Subset of SupportedLanguage.
  // Empty = all locales offered (platform default).
  supportedLanguages SupportedLanguage[] @default([])

  // General clinic settings bag â€” timezone overrides, business hours,
  // assessment duration, auto-archive days, report approval, feature flags.
  // Shape declared in lib/clinic/settings.ts; stored as JSON to avoid
  // churning the schema as toggles evolve.
  settings         Json?
  // WhatsApp business-cloud config â€” businessName, default template ids,
  // welcome/reminder copy, connectionStatus. Shape in lib/clinic/whatsapp.ts.
  whatsappSettings Json?

  status   ClinicStatus @default(ACTIVE)
  isActive Boolean      @default(true)

  subscription Subscription?

  doctors                Doctor[]
  patients               Patient[]
  assessments            Assessment[]
  visits                 ClinicVisit[]
  members                ClinicMember[]
  locations              ClinicLocation[]
  invitations            ClinicInvitation[]
  consultations          Consultation[]
  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]
  appointments           Appointment[]
  kitOrderPayments       KitOrderPayment[]
  kitFulfilments         ClinicKitFulfilment[]
  supportTickets         SupportTicket[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([slug])
}

// A physical branch of a Clinic. One Clinic organisation owns one or more
// ClinicLocations â€” "Dr ABC Hair Clinic" in Mumbai with branches in Bandra and
// Andheri is one Clinic and two ClinicLocations.
//
// Scope: this model is the geography and premises of a branch, nothing else.
// Identity, branding, locale, subscription and settings stay on Clinic and are
// deliberately not repeated here. `phone` IS repeated because a branch has its
// own reception line; that is a property of the premises, not the brand.
//
// Every address component is optional. Existing clinics carry only a free-text
// address, and a half-known address must be storable as half-known rather than
// forcing someone to invent a district or a pincode to save the row. What the
// map needs is coordinates, and those are gated separately by `geoStatus`.
model ClinicLocation {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  // Branch label within the clinic, e.g. "Bandra West". Not the clinic name.
  branchName String
  // The branch a patient reaches from the clinic-level QR or link when no
  // specific branch is named. At most one live primary per clinic.
  //
  // Enforced BOTH in the API (demote-then-promote inside a transaction, plus a
  // 409 on demoting the last primary) and in the database:
  //
  //   CREATE UNIQUE INDEX "ClinicLocation_clinicId_primary_key"
  //     ON "ClinicLocation" ("clinicId")
  //     WHERE "isPrimary" = true AND "deletedAt" IS NULL;
  //
  // Prisma cannot express a partial unique index, so it lives in
  // migrations/20260812_clinic_locations and is invisible to `@@unique` here.
  // Do not "fix" that by adding a full @@unique — it would forbid a clinic from
  // having more than one non-primary branch.
  isPrimary  Boolean @default(false)

  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  state        String?
  pincode      String?
  // ISO 3166-1 alpha-2. India-first, but the column exists so a non-IN branch
  // is representable without a schema change.
  country      String  @default("IN")

  // Never populated by inference. A coordinate is written only when a human
  // pins it or a geocoder resolves a complete structured address â€” see
  // `geoStatus`, which records which of those happened.
  latitude   Float?
  longitude  Float?
  geoStatus  LocationGeoStatus @default(UNSET)
  geocodedAt DateTime?

  status ClinicLocationStatus @default(ONBOARDING)

  // Branch reception line. Distinct from Clinic.phone (organisation contact).
  phone String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([clinicId, status])
  // Drill-down queries: India â†’ state â†’ city â†’ clinic.
  @@index([country, state, city])
  // Viewport queries for the national map. A plain btree on the pair is enough
  // for bounding-box scans at the scale we are planning for; PostGIS is not a
  // dependency we need yet.
  @@index([latitude, longitude])
  @@index([geoStatus])
}

// "A named patient is sitting in the clinic right now, filling in the
// assessment." That single operational fact, and nothing else.
//
// ── Why this is not a Patient row, and not an Assessment row ────────────────
// Assessment means SUBMITTED. That invariant is load-bearing: every count,
// queue, engine and report in the platform reads Assessment as completed
// clinical work, and a row created at question one would corrupt all of them.
// A Patient row is equally wrong — identity is resolved and written at
// submission (lib/patient/identity), and creating a person because someone
// scanned a QR code would fill the clinic's records with people who walked out
// halfway through.
//
// So the in-progress state gets its own tiny table, deliberately shaped so
// nothing clinical can ever be hung off it.
//
// ── Deliberately absent ─────────────────────────────────────────────────────
// No phone. The Doctor Dashboard shows a name so the doctor knows who is in
// the waiting room; it has no use for the number, and storing an identifier
// "in case" is how a scratch table becomes a second patient database.
// No status enum, no scheduling, no abandonment workflow, no cleanup worker.
// A visit is open when assessmentId is null; the dashboard simply stops
// showing visits older than a clinic session (see lib/doctor/clinicVisits).
// Long-term purge of abandoned rows is tracked as P2.
//
// No clinicLocationId. The intake session token carries a clinicId and nothing
// else, so a branch would have to be plumbed through the QR link, the landing
// page and the signed token before it could be recorded here. That is a
// separate slice; adding a column now would only guarantee it is null.
model ClinicVisit {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  // The signed intake session (lib/patient/intakeSession) this visit belongs
  // to. Unique because it IS the idempotency key: a patient who edits their
  // name and continues, or a client that retries, must update one visit rather
  // than fill the dashboard with duplicates of the same person.
  intakeSessionId String @unique

  // As typed at intake. A display label for the waiting-room list, never an
  // identity — the patient's real record is resolved at submission.
  displayName String

  // When identity capture succeeded. This is the ONLY thing it is used for:
  //   "Assessment in progress · started 6 min ago"
  // Doctor-review waiting time is measured from Assessment.submittedAt and
  // never from here. See lib/format/waitingTime.
  startedAt DateTime @default(now())

  // Set once, by the submission workflow, in the same transaction that creates
  // the Assessment. Unique so one visit can never be claimed by two
  // submissions. Non-null means the visit is finished: it leaves In Clinic and
  // the assessment appears in the Review Queue.
  assessmentId String?     @unique
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])

  // The dashboard's only query: open visits at this clinic within the session
  // window. Postgres can use all three columns — equality on clinicId, IS NULL
  // on assessmentId, range on startedAt.
  @@index([clinicId, assessmentId, startedAt])
}

// Non-doctor clinic staff (CLINIC_ADMIN, STAFF) bound to a single Clinic and
// to a Supabase auth user. Doctors keep their own model (Doctor) because they
// carry clinical attributes (specialization, public bio, isPrimary). The JWT
// custom_access_token_hook reads this table to inject `clinic_id` for roles
// that aren't doctors. See memory: project_jwt_custom_claims.
model ClinicMember {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  supabaseUserId String // auth.users.id from Supabase
  role           SystemRole // expected: CLINIC_ADMIN | STAFF
  name           String
  email          String
  // Mobile = WhatsApp number. Required per addendum Â§4.
  phone          String

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([clinicId, supabaseUserId])
  @@unique([clinicId, email])
  @@unique([clinicId, phone])
  @@index([clinicId])
  @@index([supabaseUserId])
}

// Invitation to join either an Organization (ORG_ADMIN) or a Clinic
// (CLINIC_ADMIN | STAFF | DOCTOR). Exactly one of clinicId/organizationId
// is set per row â€” enforced at the API layer and by the CHECK constraint
// added in the migration. The recipient receives a link containing the
// raw token; the server hashes incoming tokens before lookup so a DB
// leak doesn't expose redeemable invites.
model ClinicInvitation {
  id String @id @default(cuid())

  // Scope â€” exactly one set
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // India-first identity: phone (WhatsApp) is primary, email is secondary.
  // Either must be present; both is preferred. Enforced by CHECK constraint
  // (ClinicInvitation_contact_required) in the accompanying migration.
  email String?
  phone String?
  name  String?

  role SystemRole

  // Notification channel chosen at creation. WHATSAPP is the default per
  // addendum Â§6; sender falls back through SMS â†’ EMAIL â†’ IN_APP.
  channel   NotificationChannel @default(WHATSAPP)
  sentAt    DateTime?
  sendError String?

  // sha256(rawToken). Raw token is returned exactly once at creation; only
  // the hash is stored so a DB leak can't expose redeemable invites.
  tokenHash String @unique

  invitedBySupabaseUserId String?
  invitedByEmail          String?
  invitedByPhone          String?

  status                   InvitationStatus @default(PENDING)
  expiresAt                DateTime
  acceptedAt               DateTime?
  acceptedBySupabaseUserId String?
  revokedAt                DateTime?

  // Slice-1 lifecycle-hardening fields. Resend rotates the tokenHash + bumps
  // these counters via a compare-and-swap so concurrent Resend clicks cannot
  // both deliver messages. `resendCount` also enforces a per-invitation
  // ceiling (P0: 10). `lastResentAt` enforces the 60s cool-down.
  resendCount  Int       @default(0)
  lastResentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([status])
}

//////////////////////////////////////////////////////
// SUBSCRIPTION (per-clinic plan + quotas)
//////////////////////////////////////////////////////

// One row per Clinic. Super Admin manages plan/status; usage counters reset
// at periodEnd. Hard limits live here; the AI Command Center reads them.
model Subscription {
  id String @id @default(cuid())

  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  plan   SubscriptionPlan   @default(TRIAL)
  status SubscriptionStatus @default(ACTIVE)

  // Quota limits â€” null = unlimited.
  monthlyAssessmentLimit Int?
  doctorSeatLimit        Int?
  storageMbLimit         Int?

  // Current period usage (incremented by orchestration / upload pipelines).
  assessmentsThisPeriod Int @default(0)
  storageMbUsed         Int @default(0)

  periodStart DateTime  @default(now())
  periodEnd   DateTime?

  // Free-form notes from Super Admin.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
}

//////////////////////////////////////////////////////
// CLINIC STAFF (Doctor + general staff)
//////////////////////////////////////////////////////

// Doctors are clinic-scoped and linked to Supabase Auth.
model Doctor {
  id String @id @default(cuid())

  supabaseUserId String? @unique

  // Second Supabase identity for the SAME doctor, used by mobile-OTP login.
  //
  // Supabase mints a SEPARATE auth user for a phone sign-in and an email
  // sign-in: the phone user carries `phone` and no `email`, the email user
  // the reverse. One human doctor therefore has two auth uids, and a single
  // `supabaseUserId` column can only ever name one of them — so whichever
  // channel was linked second was permanently locked out, failing closed in
  // resolveOrLinkDoctorByPhone as a `supabaseUserId_conflict`.
  //
  // This column holds the PHONE identity; `supabaseUserId` keeps its existing
  // meaning and stays canonical. Both are resolved together through
  // `doctorAuthIdentityWhere` so mobile is primary and email still works as
  // the fallback. Unique for the same reason `supabaseUserId` is: one auth
  // identity may never name two Doctor rows.
  supabasePhoneUserId String? @unique

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  name String

  // The doctor's PERSONAL login identity, and the address the OTP is sent to.
  //
  // Nullable since 20260901. A clinician can be onboarded - clinic, branches,
  // role, profile - before anyone has confirmed a personal address for them,
  // and the only alternative to null is a placeholder that reads as a real
  // login. A publicly listed clinic reception address is NOT this field; that
  // lives on Clinic.email, and copying it here would hand clinic-wide clinical
  // access to whoever answers the front desk. The same rule governs `phone`:
  // personal mobile only, never the branch line on ClinicLocation.phone.
  //
  // NULL means "no verified personal login contact yet", which is exactly what
  // provisioningStatus = CONTACT_REQUIRED describes. Postgres treats NULLs as
  // distinct under a unique index, so any number of rows may be un-contacted.
  email          String? @unique
  // Mobile = WhatsApp number. Required per addendum Â§4.
  phone          String?
  specialization String?

  // Public-facing clinician profile, shown on the clinic landing page.
  photoUrl    String?
  credentials String?
  bio         String?
  isPrimary   Boolean @default(false)

  // Doctor avatar (workspace-internal, distinct from public photoUrl) +
  // signature applied to approved reports + preferred UI language.
  avatarUrl         String?
  signatureUrl      String?
  preferredLanguage SupportedLanguage @default(EN)

  // Per-doctor workspace-identity accent (amber, teal, rose, indigo,
  // emerald, slate, gold, plum). Nullable — a null value renders the
  // default theme. Server-persisted so the pick survives across devices,
  // browsers, and Vercel preview URLs (which each have their own origin
  // and therefore their own localStorage).
  badgeTheme String?

  // Clinical credentials shown on reports + PDF. `bio` (legacy) and
  // `biography` coexist â€” `biography` is the editable long-form used in the
  // Clinic Admin profile editor; `bio` remains the short public string.
  qualification      String?
  registrationNumber String?
  biography          String?

  // How far this clinician is along the path from "we know who they are" to
  // "they can sign in". Deliberately NOT derived from supabaseUserId alone:
  // the difference between an address nobody has confirmed and an address the
  // doctor gave us is invisible in the other columns, yet it is the fact that
  // decides whether it is safe to send an invitation. Two CHECK constraints
  // (see the 20260901 migration) stop this column claiming a readiness the
  // rest of the row contradicts.
  provisioningStatus DoctorProvisioningStatus @default(CONTACT_REQUIRED)

  // Audit-safe provenance: which onboarding run wrote this row, and when.
  // Free text rather than an enum so a batch label ("launch-cohort-2026-09")
  // traces back to the script and dataset that produced it.
  provisioningSource String?
  provisionedAt      DateTime?

  reviewedAssessments Assessment[] @relation("DoctorReviewer")

  patients Patient[]

  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]
  appointments           Appointment[]
  kitFulfilments         ClinicKitFulfilment[]
  supportTickets         SupportTicket[]

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([provisioningStatus])
}

//////////////////////////////////////////////////////
// PATIENT
//////////////////////////////////////////////////////

model Patient {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  supabaseUserId String? @unique

  name            String
  // As typed at intake. Kept verbatim so an unparseable entry (landline,
  // mistyped digit) survives for a receptionist to correct.
  phone           String?
  // Canonical E.164 â€” the identity key. Written only via
  // lib/patient/phone.toE164; null when the input could not be normalised.
  //
  // Deliberately NOT unique on (clinicId, phoneNormalized): submissions
  // created a fresh Patient row per assessment before identity resolution
  // existed, so live data already contains duplicates. Resolution picks the
  // most recent match; historical merging is a separate reviewed job.
  phoneNormalized String?
  email           String?
  age             Int?
  gender          String?

  // Set to AMBIGUOUS when intake found two or more records carrying this
  // number and quarantined the visit onto this fresh row instead of guessing.
  // The row is usable — the patient keeps their completed assessment — but a
  // human still has to say which person it belongs to.
  //
  // Queried as: identityResolutionStatus = 'AMBIGUOUS' AND clinicId = ?
  identityResolutionStatus IdentityResolutionStatus @default(RESOLVED)
  // When the ambiguity was recorded. Null on every RESOLVED row.
  identityFlaggedAt        DateTime?

  identifiers   PatientIdentifier[]
  assessments   Assessment[]
  consultations Consultation[]
  appointments  Appointment[]

  // ── WhatsApp consent (20260908_whatsapp_report_delivery) ──────────────────
  // Deliberately NOT declared on this Prisma model, even though the migration
  // adds the columns — see migration.sql's own note. Unlike WhatsappDelivery
  // (accessed EXCLUSIVELY over raw SQL, so its unapplied-migration columns are
  // safe to pre-declare here), Patient is read via the typed client in many
  // places with a bare `include: { patient: true }` and no `select` — Prisma
  // generates that as "every scalar column this schema knows about". Adding
  // whatsappConsent/whatsappConsentAt/whatsappConsentSource here broke
  // tests/post-approval/behavioural/report-sharing.test.ts the moment the
  // client regenerated, in an environment where the migration had not run:
  // every ordinary Patient read started asking Postgres for a column that did
  // not exist yet, nowhere near this feature.
  //
  // lib/patient/whatsappConsent.ts reads and writes these three columns over
  // guarded raw SQL instead, exactly like deliveryStore.ts already does for
  // WhatsappDelivery's own late-arriving columns — it needs no declaration
  // here to do that. Add these three lines back to this model ONLY together
  // with actually applying 20260908_whatsapp_report_delivery in every
  // environment `prisma generate` might run against.

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([clinicId, doctorId])
  @@index([phone])
  @@index([clinicId, phoneNormalized])
  // The unresolved-identity worklist: clinic first, then the flag.
  @@index([clinicId, identityResolutionStatus])
}

// External identifier mapping â€” links a patient to QR tokens, WhatsApp IDs, EMR IDs, etc.
// One patient can have multiple external identifiers across different sources.
model PatientIdentifier {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // e.g. "whatsapp" | "qr" | "emr" | "manual"
  source     String
  externalId String

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([patientId])
  @@index([externalId])
}

//////////////////////////////////////////////////////
// APPOINTMENT (scheduled future visit)
//////////////////////////////////////////////////////

// A patient is expected at the clinic at a stated future time.
//
// ── Why this is not ClinicVisit ─────────────────────────────────────────────
// ClinicVisit records "a named patient is in the clinic RIGHT NOW, part-way
// through the assessment" and explicitly refuses scheduling — see its comment.
// That refusal was correct for that table and stays correct: a visit is proven
// by someone physically starting an intake, an appointment is a promise about
// a time that has not happened. Booking a slot must never create a row the
// waiting-room list would render as a person who is present.
//
// The two meet only after the fact, and only in the reading direction: the
// doctor calendar shows appointments as intent and assessments as what
// actually happened on a day. Nothing links an Appointment to the Assessment
// the patient eventually submits — inferring that link from timestamps would
// be a guess, and a wrong guess would quietly rewrite clinical history.
//
// ── Why doctorId is required ────────────────────────────────────────────────
// An appointment is with a clinician, not with a building. A row without a
// doctor cannot be rendered on anyone's day, cannot be checked for conflicts,
// and would surface on every doctor's calendar as unattributed work.
//
// ── scheduledAt is an instant, not a date + slot ────────────────────────────
// Stored UTC, rendered in Clinic.timezone by the reader
// (lib/format/clinicDay). Slot grids are a presentation choice that clinics
// will change; the fact being recorded is a point in time.
//
// ── Deliberately absent ─────────────────────────────────────────────────────
// No recurrence rule, no reminder/notification state, no room or resource, no
// waitlist, no double-booking constraint. Each is a real product decision that
// has not been made. A nullable column added "for later" is a column every
// reader has to handle as null forever.
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // The clinician the patient is booked with. Required — see model comment.
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  // UTC instant. Rendered in the clinic's timezone by the reader.
  scheduledAt     DateTime
  durationMinutes Int      @default(20)

  // Short free text shown on the calendar row, e.g. "3-month follow-up".
  // Not clinical content and never read by any engine.
  reason String?
  notes  String?

  status AppointmentStatus @default(SCHEDULED)

  // Who booked it. Nullable because a future patient-facing or reception
  // booking path would legitimately have no acting doctor, and backfilling
  // this doctor's id onto those rows would be a false attribution.
  createdByDoctorId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  // The calendar's only query: one clinic's appointments inside a month
  // window. Equality on clinicId, range on scheduledAt.
  @@index([clinicId, scheduledAt])
  // "This doctor's day" and "this patient's upcoming visit" respectively.
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
}

//////////////////////////////////////////////////////
// ASSESSMENT (core clinical record)
//////////////////////////////////////////////////////

model Assessment {
  id String @id @default(cuid())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  reviewingDoctorId String?
  reviewingDoctor   Doctor? @relation("DoctorReviewer", fields: [reviewingDoctorId], references: [id])

  // Doctor review (token-link approval flow). Captured free-text for tokens
  // shared with doctors who don't yet have a Supabase account; once /doctor
  // auth lands the reviewerName/Email will be backfilled from the session.
  reviewDecision ReviewDecision @default(PENDING)
  reviewerName   String?
  reviewerEmail  String?
  reviewNotes    String?
  reviewedAt     DateTime?

  reviewPathway            ReviewPathway?
  reviewPathwayReasons     String[]       @default([])
  reviewPathwayVersion     String?
  reviewPathwayEvaluatedAt DateTime?
  reviewPathwaySource      Json?

  status AssessmentStatus @default(PENDING)
  source AssessmentSource @default(QR)

  // ── Intake context (D2) ────────────────────────────────────────────────────
  // Both are captured by the pre-assessment intake gate, before question one,
  // and are operational facts about the visit — never clinical input. No
  // engine, scorer or kit rule may read them.
  //
  // Nullable with NO backfill. Every assessment submitted before the intake
  // gate existed genuinely has no recorded intent, and defaulting those rows to
  // INITIAL would invent a fact about hundreds of past visits. Readers treat
  // null as "not captured", which is true.
  visitType           VisitType?
  patientRelationship PatientRelationshipState?

  orchestrationStage String?
  orchestrationMeta  Json?
  executionId        String?
  retryCount         Int     @default(0)
  lastError          String?
  lastCompletedStage String?

  // Phase A execution lease. Written by claimPhaseA on the winning
  // updateMany, refreshed by intra-phase status writes, expired by the
  // reclaim path. A worker whose executionId no longer matches must abort
  // without mutating state (see LeaseLostError). Bounded by phaseAAttempt.
  phaseAExecutionId    String?
  phaseALeaseExpiresAt DateTime?
  phaseAAttempt        Int       @default(0)

  rawResponses Json?

  submittedAt DateTime  @default(now())
  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // The in-clinic visit this submission closed, when the patient came through
  // the intake gate. Absent for every assessment submitted before ClinicVisit
  // existed, and for any client that submits without an intake session.
  clinicVisit ClinicVisit?

  responses              AssessmentResponse[]
  artifacts              AIArtifact[]
  events                 AssessmentEvent[]
  orchestrationLogs      OrchestrationLog[]
  analyticsEvents        AnalyticsEvent[]
  whatsappDeliveries     WhatsappDelivery[]
  auditLogs              AuditLog[]
  consultations          Consultation[]
  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]
  kitOrderPayments       KitOrderPayment[]
  kitFulfilments         ClinicKitFulfilment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clinicId])
  @@index([patientId])
  @@index([reviewingDoctorId])
  @@index([clinicId, status])
  @@index([status, phaseALeaseExpiresAt])
  // "Today's kit-fulfilment visits at this clinic" and the returning-patient
  // split, without scanning the clinic's whole assessment history.
  @@index([clinicId, visitType])
}

model AssessmentResponse {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  questionId String
  answer     Json

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([questionId])
}

//////////////////////////////////////////////////////
// AI ARTIFACT SYSTEM
//////////////////////////////////////////////////////

// Every AI output is stored as a typed artifact.
// RBAC controls which roles can read which artifact types.
// Patients: no access. Doctors/Admins: full access.
model AIArtifact {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  type ArtifactType

  engineVersion String?
  schemaVersion String?

  content Json

  generationMs Int?

  createdAt DateTime @default(now())

  @@unique([assessmentId, type])
  @@index([assessmentId])
  @@index([assessmentId, type])
}

//////////////////////////////////////////////////////
// ORCHESTRATION / PIPELINE LOGGING
//////////////////////////////////////////////////////

model OrchestrationLog {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  stage       String
  status      String
  durationMs  Int?
  confidence  Float?
  uncertainty Json?
  metadata    Json?
  error       String?

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([assessmentId, stage])
}

// Full event sourcing log â€” every lifecycle transition is recorded here.
// Used for orchestration debugging, audit trails, and the viewer timeline.
model AssessmentEvent {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  type       String // SUBMITTED | QUEUED | ORCHESTRATION_STARTED | etc.
  stage      String?
  message    String?
  metadata   Json?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([type])
  @@index([assessmentId, createdAt])
}

//////////////////////////////////////////////////////
// ANALYTICS
//////////////////////////////////////////////////////

model AnalyticsEvent {
  id String @id @default(cuid())

  // Both optional â€” some events are platform-level, not clinic-level
  clinicId     String?
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])

  eventType String
  payload   Json?

  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([eventType])
  @@index([clinicId, eventType])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// WHATSAPP DELIVERY
//////////////////////////////////////////////////////

model WhatsappDelivery {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  patientPhone String
  templateId   String?
  status       DeliveryStatus @default(PENDING)
  messageId    String?
  attempts     Int            @default(0)
  lastError    String?
  deliveredAt  DateTime?

  // ── Post-approval delivery columns (20260829_post_approval_workflow) ──────
  // Added rather than split into a second delivery table: two tables recording
  // "was this sent to the patient?" is how that question acquires two
  // different answers. See lib/delivery/deliveryStore.ts, which reads these
  // over raw SQL so the app runs before the migration is applied.

  /// WHICH business object was sent — "REPORT" | "CART". Nullable, and never
  /// silently read as REPORT: rows written before this column existed genuinely
  /// did not record a subject.
  subject String?

  /// Tenant + sender attribution. Previously a delivery could only reach a
  /// clinic by joining through Assessment, and recorded no sender at all — a
  /// message to a patient with no attributable author.
  clinicId       String?
  sentByDoctorId String?

  /// Distinct instants from `deliveredAt`, which existing code sets at
  /// hand-off. Only statuses the provider actually reports are written.
  sentAt DateTime?
  readAt DateTime?

  /// The provider's own status string, kept verbatim for support triage and
  /// never parsed into business logic — `status` is what the app reasons about.
  providerStatus String?

  // ── Report-delivery provenance (20260907_report_asset_pipeline) ───────────
  //
  // A delivery record has to answer "what exactly did this patient receive?"
  // years later, when the consultation has been revised twice and the renderer
  // rewritten. Recording only the assessment id answers "which case", which is
  // a different and much weaker question.
  //
  // Every column is nullable and none is backfilled: rows written before this
  // existed genuinely did not record these facts, and inventing values for
  // them would be worse than admitting the gap.

  /// The patient, denormalised so a delivery is attributable without joining
  /// through Assessment — whose link to the patient can change.
  patientId String?

  /// Transport. Redundant today (this table is WhatsApp), explicit because the
  /// table is now the single record of "we sent a patient something" and a
  /// second channel must not arrive as an unlabelled row.
  channel String?

  /// The EXACT approved version whose content was released. This is the column
  /// that makes the record reconstructable.
  consultationVersionId String?

  /// The rendered artefact that travelled with the message, when one did.
  reportAssetId String?

  /// Whether the one-pager was actually attached. Distinct from
  /// `reportAssetId != null`: an asset can exist and still not have been
  /// attached (feature disabled, oversized, provider rejected the media).
  onePagerAttached Boolean?

  /// Integrity of the bytes as delivered, copied from the asset at send time.
  /// Copied rather than joined so a later re-render cannot retroactively
  /// change what this historical delivery record means.
  assetSha256 String?

  /// The one-pager design version the delivered artefact was produced from.
  assetTemplateVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assessmentId])
  @@index([status])
  @@index([assessmentId, subject])
  @@index([clinicId, status])
  @@index([consultationVersionId])
}

//////////////////////////////////////////////////////
// AUDIT LOGGING
//////////////////////////////////////////////////////

// Audit Event V2 — EXPAND phase (SA-2A Phase 1).
//
// Every field below marked "V2" is additive and nullable. No existing column
// changed, nothing was backfilled, and no writer populates the new fields yet:
// that is the next phase. Until then every row is a V1 row and every V2 column
// is NULL, which is the honest representation of "this event predates the
// snapshot contract".
//
// ── Why snapshots at all ────────────────────────────────────────────────────
// Audit evidence must outlive the operational record it describes.
// `AuditLog_assessmentId_fkey` is ON DELETE SET NULL, so deleting an Assessment
// silently erases the link on every audit row that referenced it — turning an
// attributable event into an unattributable one with no trace that a link ever
// existed. A read-time join can therefore never be the basis of audit identity.
// The V2 columns copy what the event needs at write time.
//
// ── Why clinicId is NOT a relation ──────────────────────────────────────────
// Deliberately a plain scalar with no `@relation`. A foreign key would inherit
// exactly the deletion semantics above, and would additionally let audit
// history block or be damaged by clinic lifecycle operations. The audit row
// keeps the identifier even when the clinic record is gone; `clinicName` keeps
// it readable.
model AuditLog {
  id String @id @default(cuid())

  // ── Event identity ────────────────────────────────────────────────────────
  // V2. NULL on every historical row and left that way: NULL means "written
  // before event versioning existed", which is a fact. A default of 1 would
  // have been an assertion about rows nobody inspected.
  eventVersion Int?
  // V2. Timezone-aware successor to `createdAt`, which is `timestamp without
  // time zone` and therefore ambiguous the moment anything runs in a second
  // region. `createdAt` is deliberately left untouched — altering the type of
  // a column on an audit table rewrites it, and rewriting history is the one
  // thing this table must never do. Readers coalesce.
  occurredAt   DateTime? @db.Timestamptz(3)

  // Who performed the action
  actorId   String?
  actorRole SystemRole?
  actorType String? // "doctor" | "admin" | "system" | "patient"

  // ── Frozen actor snapshot (V2) ────────────────────────────────────────────
  // `actorRole` above is NOT redefined. Its semantics were never contractual —
  // it is populated by some writers and not others (null on ~10% of rows) — so
  // rather than quietly reinterpret it as a historical snapshot, V2 records the
  // claim in its own clearly named column. The two coexist; readers branch on
  // eventVersion.
  actorName         String?
  actorEmail        String?
  actorRoleSnapshot SystemRole?

  // ── Frozen clinic snapshot (V2) ───────────────────────────────────────────
  // Plain scalars. No relation, by design — see the header note.
  clinicId   String?
  clinicName String?

  // What was acted upon
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  entityType   String
  entityId     String
  // V2. A short human-readable description frozen at write time so the event
  // stays meaningful after its subject is deleted. A label, never a serialized
  // record — full entity payloads do not belong in an audit table.
  entityLabel  String?

  action   String
  metadata Json?

  // ── Change evidence (V2) ──────────────────────────────────────────────────
  // Named `beforeState` / `afterState` rather than `before` / `after`: this
  // table is queried by hand during investigations, and `before` is a keyword
  // in enough SQL contexts to make an unquoted ad-hoc query fail confusingly.
  // Populated only for administrative and governance mutations, never for
  // clinical content — that is versioned in ConsultationVersion already.
  beforeState Json?
  afterState  Json?

  // ── Request context (V2) ──────────────────────────────────────────────────
  // Only the two fields the design justified. `ipAddress`, `userAgent` and
  // `correlationId` were evaluated and declined: the first is personal data
  // needing a retention decision and lawful basis, the second is high
  // cardinality with little investigative value, and the third has no tracing
  // system to correlate with.
  requestId String?
  source    String? // "web" | "api" | "webhook" | "system" | "script"

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([assessmentId])
  // V2 indexes. See the migration for the query each one serves.
  @@index([createdAt(sort: Desc)])
  @@index([clinicId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

//////////////////////////////////////////////////////
// PLATFORM SETTINGS (Super Admin owned, singleton)
//////////////////////////////////////////////////////

// Singleton row â€” enforced by `singletonKey = 'singleton'` unique. Holds
// platform-wide defaults the Super Admin tunes from /admin/settings.
model PlatformSettings {
  id           String @id @default(cuid())
  singletonKey String @unique @default("singleton")

  platformName            String            @default("HairOS")
  defaultTheme            String            @default("system") // light | dark | system
  defaultLanguage         SupportedLanguage @default(EN)
  defaultWhatsappTemplate String?

  // AI defaults (read-only in this phase â€” surfaced for visibility).
  aiModelDefault String?
  aiNotes        String?

  versionInfo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// LEGACY CHAT / WHATSAPP SESSION ENGINE
// Keep intact â€” do not touch without explicit migration plan
//////////////////////////////////////////////////////

model User {
  id    String  @id @default(cuid())
  name  String?
  phone String?

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model Session {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  state Json

  messages         Message[]
  diagnosis        Diagnosis?
  whatsappSessions WhatsappSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsappSession {
  id String @id @default(cuid())

  waId String @unique

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @default(cuid())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  sender   String
  text     String?
  metadata Json?

  createdAt DateTime @default(now())
}

model Diagnosis {
  id String @id @default(cuid())

  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id])

  condition  String
  confidence Float

  rootCauses      Json
  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recommendation {
  id String @id @default(cuid())

  diagnosisId String
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id])

  title     String
  productId String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// CONSULTATION AGGREGATE (Sprint 2 â€” orchestrator output)
//////////////////////////////////////////////////////

// The Consultation aggregate root. One per Assessment per clinical workflow.
// Holds a pointer to the latest ConsultationVersion; older versions remain
// immutable for audit + diffing. Tenant-scoped via clinicId.
model Consultation {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  status ConsultationStatus @default(DRAFT)

  // Pointer to the latest version. Always set after createConsultation.
  currentVersionId String?              @unique
  currentVersion   ConsultationVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  versions               ConsultationVersion[]    @relation("ConsultationVersions")
  events                 ConsultationEvent[]
  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId])
  @@index([clinicId])
  @@index([patientId])
  @@index([clinicId, status])
}

// Immutable snapshot of a consultation's content. New versions are appended
// on doctor edits; the canonical Consultation JSON lives in `content`.
model ConsultationVersion {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation("ConsultationVersions", fields: [consultationId], references: [id])

  // Monotonic per consultation â€” 1, 2, 3 â€¦
  contentVersion Int
  schemaVersion  String @default("v1")

  // Snapshot of @shared/types/consultation.Consultation.
  content Json

  // Per-engine version stamps captured at composition time. Used for cache
  // invalidation and replay.
  engineVersions Json

  // Deterministic SHA-256 of normalized `content`. Used for idempotency:
  // re-running the pipeline with identical inputs skips creating a duplicate
  // version.
  contentHash String

  // AI provenance â€” captured for regression testing + audit. Null on
  // versions produced purely by deterministic engines (no LLM in the loop).
  llmModel             String?
  promptVersion        String?
  knowledgeBaseVersion String?

  // Clinical approval lifecycle. Patient-facing surfaces should only show
  // versions where approvalStatus = APPROVED.
  approvalStatus ConsultationApprovalStatus @default(PENDING_REVIEW)
  approvedBy     String?
  approvedAt     DateTime?

  // Doctor-supplied notes captured at approval time (e.g., reason for edit).
  // Kept on the version row so audits don't need to chase the audit log.
  approvalNotes String?

  createdBy String
  createdAt DateTime @default(now())

  // Back-reference used only when this row is the current pointer.
  currentOf Consultation? @relation("CurrentVersion")

  kitOrderIntents        KitOrderIntent[]
  recommendationFeedback RecommendationFeedback[]

  @@unique([consultationId, contentVersion])
  @@index([consultationId])
  @@index([contentHash])
}

// Durable outbox of domain events emitted by the orchestrator. Written in the
// same transaction as the version that produced them; dispatched out-of-band
// by an in-process handler today, ready for a real queue later.
model ConsultationEvent {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  type    ConsultationEventType
  status  ConsultationEventStatus @default(PENDING)
  payload Json

  // The version that caused the event, when applicable. Null for events that
  // are version-independent (e.g., PATIENT_NOTIFICATION_REQUESTED).
  consultationVersionId String?

  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([consultationId])
  @@index([status, createdAt])
  @@index([type, status])
}

//////////////////////////////////////////////////////
// DOCTOR VALIDATION LOOP â€” order intent + feedback
//////////////////////////////////////////////////////

// Canonical, minimal durable record of the doctor's approval-time intent to
// operationalize the approved kit lineup. This is NOT billing, inventory,
// payments, or fulfilment â€” just the least amount of state needed for ops to
// act on the doctor's authorization.
//
// Idempotency is guaranteed by @@unique([consultationId, consultationVersionId]):
// repeated "Approve & create kit order" clicks against the same approved
// version return the same intent row.
model KitOrderIntent {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  consultationVersionId String
  consultationVersion   ConsultationVersion @relation(fields: [consultationVersionId], references: [id])

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  // Kit lineup captured at approval time â€” audit-stable snapshot. `kitIds`
  // is the doctor's final order; `quantities` is a { kitId: number } map or
  // null when quantities aren't defined yet.
  kitIds     String[]
  quantities Json?

  // Doctor approval IS the clinical authorization; ops picks up from here.
  status KitOrderStatus @default(READY_FOR_FULFILMENT)

  // ── Post-approval columns (20260829_post_approval_workflow) ──────────────
  // Both are properties of THIS order — where its kits go, and when the
  // patient actually began taking them — so they live on the order rather than
  // in a side table that could disagree with it about a single row.

  /// Destination for this order's kits. NULL = never captured, which is the
  /// honest state for every intent created before the column existed. Readers
  /// resolve NULL through one documented default in lib/fulfilment/fulfilmentMode.
  fulfilmentMode KitFulfilmentMode?

  /// THE follow-up anchor. Deliberately not derived from approval, payment or
  /// delivery dates: for a clinic-supplied kit the patient starts days after
  /// delivery, and inferring it would mis-date every Day-30/60/90 checkpoint
  /// later built on it.
  treatmentStartedAt   DateTime?
  /// Doctor.id of whoever recorded the start; NULL when no start is recorded.
  treatmentStartedBy   String?
  /// How the start was established, e.g. "DOCTOR_RECORDED". Constrained by the
  /// writer rather than by an enum, so a later source needs no migration.
  treatmentStartSource String?

  payment    KitOrderPayment?
  fulfilment ClinicKitFulfilment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([consultationId, consultationVersionId])
  @@index([clinicId, createdAt])
  @@index([doctorId])
  @@index([assessmentId])
  @@index([clinicId, treatmentStartedAt])
}

enum KitOrderStatus {
  READY_FOR_FULFILMENT
  CANCELLED
}

//////////////////////////////////////////////////////
// POST-APPROVAL OPERATIONS — payment + clinic kit fulfilment
//
// Migration: prisma/migrations/20260829_post_approval_workflow (NOT APPLIED —
// 2026-08-20 baseline freeze). Every reader talks to these objects over raw
// SQL (lib/payments/paymentStore.ts, lib/fulfilment/fulfilmentStore.ts) so the
// application compiles and boots whether or not the tables exist; the surfaces
// answer "not provisioned" until someone applies the migration.
//////////////////////////////////////////////////////

/// Where the approved kits physically go. Recorded per order rather than
/// hard-coded, because direct-to-patient dispatch is a real Wave-1 shape.
enum KitFulfilmentMode {
  PATIENT
  CLINIC
}

/// Ops-side lifecycle of one clinic kit supply request. The legal transitions
/// are enforced in lib/fulfilment/stateMachine.ts, not by this type: an enum
/// constrains the VALUE, not the PATH, and the path is the part that matters
/// — a request must not jump straight to DELIVERED.
enum KitFulfilmentStatus {
  REQUESTED
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  ACKNOWLEDGED
  CANCELLED
}

/// PENDING exists so "checkout was started" is distinguishable from "nobody
/// has tried yet". A row only ever reaches PAID through an authoritative
/// server-side confirmation — see KitOrderPaymentSource.
enum KitOrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// WHO said this was paid — the security boundary of the commerce path, so it
/// is persisted rather than assumed.
///
/// There is deliberately no PATIENT_DECLARED or CLIENT_REDIRECT member: a
/// browser cannot mark an order paid under any code path.
enum KitOrderPaymentSource {
  /// A payment provider's signed server-to-server callback, signature-verified
  /// before it is trusted.
  PROVIDER_WEBHOOK
  /// An authenticated clinic user recorded a payment taken at the desk.
  /// Genuinely authoritative for Wave 0, where clinics collect in person, and
  /// attributable because the actor is on the row.
  CLINIC_COUNTER
}

/// Commercial state of one approved kit order.
///
/// Separate from KitOrderIntent because that row is an immutable snapshot of a
/// CLINICAL authorization — its own comment says it is "NOT billing … or
/// fulfilment" — while this is a mutable commercial fact that can be retried,
/// refunded and reconciled independently.
model KitOrderPayment {
  id String @id @default(cuid())

  /// One payment per order. The unique constraint — not a handler's
  /// if-statement — is what makes confirmation idempotent: a replayed webhook
  /// cannot create a second row.
  kitOrderIntentId String         @unique
  kitOrderIntent   KitOrderIntent @relation(fields: [kitOrderIntentId], references: [id])

  /// Denormalised so ops queries and tenant checks read a column on this row
  /// instead of joining out to reach a clinicId.
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  status KitOrderPaymentStatus  @default(PENDING)
  source KitOrderPaymentSource?

  /// Minor units (paise). Integer on purpose — a float rupee amount is a
  /// rounding error waiting to be reconciled against a bank statement.
  amountMinor Int?
  currency    String @default("INR")

  /// Provider identity. The pair is unique so the same event replayed twice —
  /// the normal behaviour of every gateway's retry policy — is rejected by the
  /// database rather than by a race-prone read-then-write.
  provider    String?
  providerRef String?

  /// Who recorded a CLINIC_COUNTER payment. NULL for webhook rows: no human
  /// took that action, and naming one would be a false attribution.
  recordedByDoctorId String?

  checkoutStartedAt DateTime?
  paidAt            DateTime?
  failedAt          DateTime?
  lastError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([clinicId, status])
  @@index([assessmentId])
}

/// Ops fulfilment of one clinic kit supply request.
///
/// Deliberately carries NO patient name, phone, clinical content or kit
/// lineup. The lineup lives on KitOrderIntent and is read through the
/// relationship: ops needs to know WHICH order to pack, not what the patient's
/// scalp looks like.
model ClinicKitFulfilment {
  id String @id @default(cuid())

  /// One fulfilment per order — the constraint that makes "create a request on
  /// payment confirmation" idempotent under duplicate webhooks, with no
  /// read-then-write window two concurrent callbacks could both pass.
  kitOrderIntentId String         @unique
  kitOrderIntent   KitOrderIntent @relation(fields: [kitOrderIntentId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  mode   KitFulfilmentMode   @default(CLINIC)
  status KitFulfilmentStatus @default(REQUESTED)

  /// One timestamp per business state rather than a single `statusChangedAt`:
  /// SLA questions are asked about specific legs ("how long from CONFIRMED to
  /// DISPATCHED"), which a single mutable column cannot answer after the fact.
  requestedAt    DateTime  @default(now())
  confirmedAt    DateTime?
  packedAt       DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  cancelledAt    DateTime?

  /// Who acknowledged receipt at the clinic, and free-text ops context
  /// (courier, waybill). Never clinical content.
  acknowledgedByDoctorId String?
  notes                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, status])
  /// The Ops queue: everything unfinished, oldest first, across tenants.
  @@index([status, requestedAt])
  @@index([assessmentId])
}

// Structured doctor feedback on a specific consultation version. Never mutates
// recommendations automatically â€” this is the pilot's learning-loop capture.
// clinicalRationale is required at write time for SAFETY_CONCERN / INCORRECT
// (validated in the endpoint), optional otherwise.
model RecommendationFeedback {
  id String @id @default(cuid())

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  // The version the doctor was reviewing when the feedback was recorded.
  consultationVersionId String
  consultationVersion   ConsultationVersion @relation(fields: [consultationVersionId], references: [id])

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  verdict           FeedbackVerdict
  issueType         FeedbackIssueType
  severity          FeedbackSeverity
  expectedKitOrder  String[]
  affectedKitIds    String[]
  clinicalRationale String?           @db.Text

  createdAt DateTime @default(now())

  @@index([consultationId])
  @@index([clinicId, createdAt])
  @@index([doctorId])
}

enum FeedbackVerdict {
  CORRECT
  PARTLY_CORRECT
  INCORRECT
  SAFETY_CONCERN
}

// Recommendation feedback categories are strictly clinical. "Needs revision"
// is a consultation-workflow action captured via the approve endpoint, NOT a
// feedback category, so it does not appear here.
enum FeedbackIssueType {
  WRONG_KIT_INCLUDED
  WRONG_KIT_EXCLUDED
  WRONG_ORDER
  MISSING_KIT
  SAFETY_ISSUE
  CONDITION_INTERPRETATION
  NARRATIVE_ONLY
  OTHER
}

enum FeedbackSeverity {
  LOW
  MEDIUM
  HIGH
}

