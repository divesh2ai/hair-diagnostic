//////////////////////////////////////////////////////
// REPORT ASSETS — rendered clinical artefacts
//////////////////////////////////////////////////////

// What kind of artefact a ReportAsset row describes.
//
// ONE_PAGER_PNG is the only kind produced today. The others are declared now
// because the pipeline around them is type-driven: adding a second artefact
// later must be a renderer registration, not a second table, a second queue
// and a second share path.
enum ReportAssetType {
  ONE_PAGER_PNG
  ONE_PAGER_PDF
  PATIENT_REPORT_PDF
  DOCTOR_SUMMARY_PDF
}

// Lifecycle of one rendered artefact. Also the queue: a row that is PENDING
// or QUEUED with `nextAttemptAt` in the past is work waiting to be done, and
// the worker finds it by that fact alone.
//
//   PENDING    Created by the approval path. Nothing has claimed it.
//   QUEUED     A dispatch has been requested. Behaves exactly like PENDING to
//              the claimer — the distinction is for operators reading the
//              table, not for the state machine.
//   RENDERING  Claimed under a lease. `leaseExpiresAt` bounds the claim so a
//              worker that dies mid-render does not strand the row.
//   READY      Bytes exist in private storage, validated, hashed.
//   FAILED     Terminally failed: either a permanent error classification or
//              the retry budget is exhausted.
enum ReportAssetStatus {
  PENDING
  QUEUED
  RENDERING
  READY
  FAILED
}

// A durable record of one rendered clinical artefact, and the queue entry that
// produces it.
//
// ── Why the row IS the queue ────────────────────────────────────────────────
// The alternative is an outbox event that says "render this" alongside a row
// that says "this is the render". Two records of one intention is how a system
// acquires two disagreeing answers to "did we make the patient's one-pager?".
// Creating this row in the approval transaction means the commit IS the
// enqueue: a process that crashes immediately after committing has still
// durably recorded the work, and the sweeper finds it. There is no window in
// which the approval is durable and the render request is not.
//
// ── Why no @relation anywhere ───────────────────────────────────────────────
// Same reasoning as AuditLog.clinicId, and for the same reason: this is
// evidence about a clinical release, and it must outlive the operational rows
// it describes. A foreign key with ON DELETE SET NULL would silently erase the
// link between a delivered artefact and the version it was rendered from,
// turning an auditable record into an orphan with no trace that a link existed.
// The identifiers are kept as plain scalars and are never nulled.
//
// ── Immutability ────────────────────────────────────────────────────────────
// A row is bound to ONE ConsultationVersion. A revised consultation approves
// as a new version and therefore gets its OWN row and its own storage object.
// Nothing here is ever rewritten to point at different bytes: `storagePath`
// carries the asset id, so a re-render after a FAILED attempt writes beside
// its predecessor rather than over it.
model ReportAsset {
  id String @id @default(cuid())

  // Tenant + subject. Denormalised deliberately (see above) so an asset can be
  // authorised and audited without joining through rows that may be gone.
  clinicId     String
  patientId    String?
  assessmentId String

  consultationId        String
  consultationVersionId String
  /// The approved version's monotonic number. Redundant with
  /// consultationVersionId, and kept because the snapshot object is addressed
  /// by it — `one-pagers/{assessmentId}/v{contentVersion}.json`.
  contentVersion        Int

  type   ReportAssetType
  status ReportAssetStatus @default(PENDING)

  /// The one-pager DESIGN this artefact was produced from, e.g.
  /// "hair-one-pager-v1". A component change that alters what the sheet says
  /// must bump this, which produces a NEW asset rather than silently mutating
  /// the historical one.
  templateVersion String
  /// The rendering STACK — browser + pipeline. Bumped when the renderer itself
  /// changes in a way that could alter output pixels.
  rendererVersion String

  // ── Stored bytes. Null until READY. ──────────────────────────────────────
  storageBucket String?
  storagePath   String?
  mimeType      String?
  byteSize      Int?
  /// Integrity of the exact bytes delivered. A delivery row copies this, so a
  /// later re-render cannot change what a historical delivery record means.
  sha256        String?

  // ── Queue + retry bookkeeping ────────────────────────────────────────────
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  /// When this row next becomes claimable. Backoff is expressed here rather
  /// than in a scheduler, so the retry policy survives a worker restart.
  nextAttemptAt DateTime?
  generatedAt   DateTime?

  /// Lease held by the worker currently rendering. `leaseId` identifies the
  /// claimer so a slow worker whose lease expired cannot write a result over a
  /// successor's; `leaseExpiresAt` is what makes a dead worker's claim
  /// reclaimable without human intervention.
  leaseId        String?
  leaseExpiresAt DateTime?

  /// Classified failure (see lib/reports/assets/errors). Never a raw message.
  errorCode String?
  /// Redacted detail for support triage. Never secrets, never patient content.
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Idempotency ──────────────────────────────────────────────────────────
  // The render key. Two requests that mean the same artefact CANNOT produce
  // two rows, enforced by the database rather than by an application-side
  // findFirst() that loses every race it is asked to win.
  @@unique([consultationVersionId, type, templateVersion, rendererVersion], name: "render_key")
  @@index([status, nextAttemptAt])
  @@index([clinicId, status])
  @@index([assessmentId, type])
  @@index([status, createdAt])
}

//////////////////////////////////////////////////////
// SUPPORT INBOX
//////////////////////////////////////////////////////

// Seven governed categories a doctor selects when opening a ticket.
// Free-text "Other" exists so nothing is unraisable.
enum SupportTicketCategory {
  PATIENT_ASSESSMENT
  REPORT
  KIT_PRESCRIPTION
  WHATSAPP
  LOGIN_ACCESS
  TECHNICAL_ISSUE
  OTHER
}

enum SupportTicketPriority {
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// One row per support request. Scoped to a doctor + clinic pair so
// assertDoctorInClinic remains the isolation primitive.
//
// Clinical context (assessmentId, consultationId, reportVersionId) is stored
// as plain scalars — no FK — so a deleted assessment does not cascade into the
// support history. Super Admin may look up the linked case if still authorized.
model SupportTicket {
  id       String @id @default(cuid())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  category SupportTicketCategory
  priority SupportTicketPriority @default(NORMAL)
  status   SupportTicketStatus   @default(OPEN)

  subject String

  // Optional clinical context auto-attached from the screen the doctor was on.
  assessmentId    String?
  consultationId  String?
  reportVersionId String?
  raisedFromRoute String?

  messages SupportMessage[]

  // Unread tracking: NULL means "never viewed". Unread count for each party
  // is messages by the other party created after their lastSeenAt.
  doctorLastSeenAt DateTime?
  adminLastSeenAt  DateTime?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([doctorId])
  @@index([clinicId])
  @@index([status, createdAt])
  @@index([createdAt])
}

// One reply in a support thread. Author identity is frozen at write time so
// a renamed or deleted account does not corrupt the audit trail.
model SupportMessage {
  id       String @id @default(cuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // supabaseUserId of the sender — never the Doctor row id.
  authorId   String
  authorName String
  // DOCTOR | SUPER_ADMIN — stored as text so the value survives enum changes.
  authorRole String

  body String @db.Text

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
