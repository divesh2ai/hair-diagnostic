# HairOS Super Admin — Clinic Usage & Adoption Monitor
#
# The dashboard resolves ALL authentication data (sign-ins, providers) and all
# clinic metrics server-side. The service-role key must NEVER be exposed to the
# browser (lib/supabase.ts imports `server-only` to enforce this).
#
# When these are set, /admin queries live production. When they are absent, the
# app serves the committed read-only verification snapshot
# (lib/data/production-snapshot.json) and renders identically.

SUPABASE_URL=https://pykoyxbleowxwechotth.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # secret — server-side only, do not commit
