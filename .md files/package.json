{
  "name": "hair-diagnosis-saas",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "kb:import": "powershell -ExecutionPolicy Bypass -File .\\tools\\import-kb.ps1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "prisma migrate diff --from-empty --to-url $DIRECT_URL --script",
    "db:studio": "prisma studio",
    "baselines:generate": "tsx scripts/generate-baselines.ts",
    "sandbox:run": "tsx src/sandbox/executeSandbox.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.106.0",
    "axios": "^1.4.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "gsap": "^3.15.0",
    "openai": "^4.0.1",
    "pg": "^8.11.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.0",
    "@types/supertest": "^2.0.16",
    "@types/three": "^0.184.1",
    "docx": "^9.7.1",
    "jest": "^29.7.0",
    "prisma": "^5.0.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  }
}
