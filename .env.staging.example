# Staging configuration — hairos-staging (Supabase project vbkoupvduadmcxggtnsb)
#
# Copy to `.env` and `apps/patient-portal/.env.local` to point local development
# at staging instead of production. Two values are secrets this file cannot
# carry; both come from the Supabase dashboard and are marked <<< FILL IN >>>.
#
# Project:  hairos-staging
# Ref:      vbkoupvduadmcxggtnsb
# Region:   ap-south-1 (Mumbai)
# Data:     synthetic only. Never copy production patient rows here.
#
# ── The two secrets ─────────────────────────────────────────────────────────
# 1. Database password
#    The project was created via the management API, which generates a password
#    and never returns it. Set one:
#      Supabase dashboard → hairos-staging → Settings → Database →
#      "Reset database password". Copy it straight into the two URLs below.
#
# 2. service_role key
#      Supabase dashboard → hairos-staging → Settings → API keys → service_role
#    It bypasses RLS. It must never appear in a NEXT_PUBLIC_* name, in git, or
#    in a chat window.
#
# The database guard in packages/shared/env/databaseTarget.ts refuses to start
# any non-production process against the production project, so a half-finished
# copy of this file fails closed with an explanatory error rather than quietly
# reconnecting to live patient data.

# ── Database ────────────────────────────────────────────────────────────────
# Pooled connection for the app runtime.
DATABASE_URL="postgresql://postgres.vbkoupvduadmcxggtnsb:<<< FILL IN: DB PASSWORD >>>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection for Prisma migrations. Never used by the app runtime.
DIRECT_URL="postgresql://postgres.vbkoupvduadmcxggtnsb:<<< FILL IN: DB PASSWORD >>>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Supabase API ────────────────────────────────────────────────────────────
# Public. Baked into the client bundle — must match the URLs above or uploaded
# clinical images land in a different project from their database rows.
NEXT_PUBLIC_SUPABASE_URL="https://vbkoupvduadmcxggtnsb.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZia291cHZkdWFkbWN4Z2d0bnNiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY1MzE0ODksImV4cCI6MjEwMjEwNzQ4OX0.o5NteUJ0gUbLk_0SfhTN0y37CORmtc1H8fRKdizqIF4"
SUPABASE_SERVICE_ROLE_KEY="<<< FILL IN: service_role key >>>"

# ── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:4000"
PORT=4000

# ── Secrets that must differ from production ────────────────────────────────
# Signs review tokens AND the patient intake session token. If staging shared
# production's value, a token minted in staging would authenticate against
# production. Any long random string is fine — it only has to be different.
REVIEW_TOKEN_SECRET="staging-only-change-me-to-something-random"

# ── Dev login (staging + local only) ────────────────────────────────────────
# api/dev/login refuses to run when VERCEL_ENV=production, so this is safe here
# and is what lets a staging walk-through happen without real accounts.
ALLOW_DEV_LOGIN=1
NEXT_PUBLIC_ALLOW_DEV_LOGIN=1
DEV_LOGIN_SECRET="staging-only-dev-login-secret"
NEXT_PUBLIC_DEV_LOGIN_SECRET="staging-only-dev-login-secret"

# ── Outbound communication: deliberately UNSET ──────────────────────────────
# WhatsApp is the only channel wired to a real provider (Meta Cloud API, see
# lib/notifications/index.ts). With these unset the code takes its
# `provider_not_configured` branch: it logs and returns ok=false without making
# a network call, so staging physically cannot message a real patient.
#
# Do not copy the production token here. If WhatsApp delivery genuinely needs
# testing, use a Meta test number.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=

# ── Model / knowledge configuration: same as production on purpose ──────────
# Staging must exercise the same clinical engine or a walk-through proves
# nothing. These cost real inference money — copy the values from your existing
# .env rather than leaving them blank.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# OPENAI_API_KEY=
# RAG_DOCS_PATH=
